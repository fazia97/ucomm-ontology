        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Volume"/>
        <rdfs:comment xml:lang="en">Relates a manuscript to one or more physical volumes that constitute its material structure.</rdfs:comment>
        <rdfs:label xml:lang="en">has volume</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasPart -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasPart">
