            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Collection"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#IdentificationInformation"/>
        <rdfs:comment xml:lang="en">it is for identification information of a collection or a manuscript</rdfs:comment>
        <rdfs:label xml:lang="en">has identification informations</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasIdentifierInfo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasIdentifierInfo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Catalogue"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#CatalogueIdentifier"/>
        <rdfs:comment xml:lang="en">The value of the identifier attribute must consist of a unique international identifier, either generated by the system (such as an ARK), or entered according to the following structure: FR, followed, where applicable, by the collective catalog identifier and the RCR number of the institution responsible for intellectual access according to the order defined by the collective catalogue, and finally a unique identifier.</rdfs:comment>
        <rdfs:label xml:lang="en">has identifier information</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasIncipit -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasIncipit">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#MsItem"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Incipit"/>
        <rdfs:comment xml:lang="en">a work has an incipit</rdfs:comment>
        <rdfs:label xml:lang="en">has incipit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLangMaterial -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLangMaterial">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Language"/>
        <rdfs:comment xml:lang="en">the language in which the manuscript is written with</rdfs:comment>
        <rdfs:label xml:lang="en">has lang material</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLangUsage -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLangUsage">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Catalogue"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#LangUsage"/>
        <rdfs:comment xml:lang="en">It is used to indicate the language or languages in which the finding aid was written.</rdfs:comment>
        <rdfs:label xml:lang="en">has language usage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLanguage -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLanguage">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#MsItem"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Record"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Language"/>
        <rdfs:comment xml:lang="en">a record or a manuscript item is written in a language e.G. french, english,...</rdfs:comment>
        <rdfs:label xml:lang="en">ha language</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLayout -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLayout">
