        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Subject"/>
        <rdfs:comment xml:lang="en">a manuscript has a subject</rdfs:comment>
        <rdfs:label xml:lang="en">has subject</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasSupport -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasSupport">
