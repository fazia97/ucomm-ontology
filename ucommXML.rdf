        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#WrittingStyle"/>
        <rdfs:comment xml:lang="en">a manuscript is written with a writting style</rdfs:comment>
        <rdfs:label xml:lang="en">has Writting Style</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#includes -->

