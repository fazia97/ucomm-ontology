        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#RevisionDesc"/>
        <rdfs:comment xml:lang="en">a catalogue has revision description</rdfs:comment>
        <rdfs:label xml:lang="en">has revision description</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasScribe -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasScribe">
