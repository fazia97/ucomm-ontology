                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Date"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Distributor"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Publisher"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">the publication information includes the publisher, the place of publication, ..</rdfs:comment>
        <rdfs:label xml:lang="en">includes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isAuthorOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isAuthorOf">
        <rdfs:comment xml:lang="en">an entity is author of a manuscript</rdfs:comment>
        <rdfs:label xml:lang="en">is author of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isConservatingInstitutionOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isConservatingInstitutionOf">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isConservedInInstitution"/>
        <rdfs:comment xml:lang="en">it is the conservating institution where a manuscript is conserved</rdfs:comment>
        <rdfs:label xml:lang="en">is the conservating institution of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isConservedInCity -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isConservedInCity">
