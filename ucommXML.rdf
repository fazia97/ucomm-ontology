                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Record"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#PublicationInfo"/>
        <rdfs:comment xml:lang="en">a record or a catalogue has a publication information</rdfs:comment>
        <rdfs:label xml:lang="en">has publication information</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasQuire -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasQuire">
