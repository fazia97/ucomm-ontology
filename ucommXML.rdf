        <rdfs:comment xml:lang="en">writting style or manuscript has a scribe (copyist)</rdfs:comment>
        <rdfs:label xml:lang="en">has scribe</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasSubject -->

