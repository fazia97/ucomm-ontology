        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#City"/>
        <rdfs:comment xml:lang="en">the city where the manuscript is conserved</rdfs:comment>
        <rdfs:label xml:lang="en">is Conserved In City</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isConservedInInstitution -->

