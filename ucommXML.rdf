<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#"
     xml:base="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm">
        <dc:creator>Fazia BRINIS (ORCID: https://orcid.org/0009-0003-2835-4054)</dc:creator>
        <dc:description xml:lang="en">Ancient Arabic manuscripts represent a valuable cultural heritage for humanity. Their digitization contributes both to their preservation and to broadening access for the international scholarly community. However, the effective exploitation of these digital resources within digital libraries remains challenged by several major issues. On the one hand, the heterogeneity of the encoding formats of the catalogues, resulting from the use of various standards such as EAD (Encoded Archival Description), TEI (Text Encoding Initiative), MARCXML (Machine Readable Cataloguing), MODS (Metadata Object Description Schema), or DC (Dublin Core) by heritage institutions, complicates cross-catalogue searching. On the other hand, these standards often have gaps or missing information for certain metadata, as the corresponding values are not systematically provided or are poorly represented, which limits semantic exploitation and search quality \n.

        Furthermore, existing cataloguing standards are generally designed for specific types of manuscripts, leading to the marginalization of certain manuscript traditions, particularly Arabic manuscripts, which do not currently have a universally adopted cataloguing standard. All of these factors hinder global, integrated and optimal access to digitized collections. To address these issues, this article proposes a semantic approach guided by an ontology called UCOMM (Unified Cataloguing Ontology Model for Manuscripts), which aims to ensure interoperability between the metadata encoding formats of digitized ancient manuscripts \r. 

This approach introduces a unified conceptual model, developed from the common concepts of existing standards and formalized using semantic web technologies, notably RDF (Resource Description Framework) and OWL (Web Ontology Language), in order to facilitate the integration, enrichment, and unified querying of heterogeneous catalogues \r. 

By aligning manuscript metadata with Linked Data principles, the proposed model contributes to improving the compliance of these metadata with the FAIR principles, thereby enhancing their findability, accessibility, interoperability, and reusability within digital library infrastructures.</dc:description>
        <dc:rights xml:lang="en">This work is distributed under a Creative Commons Attribution 4.0 International License (CC BY 4.0) (https://creativecommons.org/licenses/by/4.0/)</dc:rights>
        <rdfs:comment xml:lang="en">UCOMM (Unified Cataloguing Ontology Model for Manuscripts) is an Ontological model for the Heterogeneous Manuscript Resources</rdfs:comment>
        <rdfs:label xml:lang="en">Unified Cataloguing Ontology Model for Manuscripts</rdfs:label>
        <owl:versionInfo xml:lang="en">version 1-1-2026</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/elements/1.1/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
    


    <!-- http://purl.org/dc/elements/1.1/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/description"/>
    


    <!-- http://purl.org/dc/elements/1.1/rights -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/rights"/>
    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#conservesCollection -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#conservesCollection">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasConservationInstitution"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Institution"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Collection"/>
        <rdfs:comment xml:lang="en">an institution conserves a collection of manuscripts</rdfs:comment>
        <rdfs:label xml:lang="en">conserves collection</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#containsCity -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#containsCity">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Country"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#City"/>
        <rdfs:comment xml:lang="en">a country contains one or more cities</rdfs:comment>
        <rdfs:label xml:lang="en">contains city</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#containsManuscript -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#containsManuscript">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isContainedInCollection"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Collection"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:comment xml:lang="en">a collection has one or more manuscripts</rdfs:comment>
        <rdfs:label xml:lang="en">contains manuscript</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#containsRecord -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#containsRecord">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isContainedInCatalogue"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Catalogue"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Record"/>
        <rdfs:comment xml:lang="en">a catalogue contains one or more manuscript records</rdfs:comment>
        <rdfs:label xml:lang="en">contains record</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#copied -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#copied">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isCopiedBy"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Scribe"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:comment xml:lang="en">a scribe copied a manuscript</rdfs:comment>
        <rdfs:label xml:lang="en">copied</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#describesCollection -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#describesCollection">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isDescribedByCatalogue"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Catalogue"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Collection"/>
        <rdfs:comment xml:lang="en">the finding aid (catalogue) describes a collection of manuscripts</rdfs:comment>
        <rdfs:label xml:lang="en">describes collection</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#describesManuscript -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#describesManuscript">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isDescribedByRecord"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Record"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:comment xml:lang="en">a record describes a manuscript</rdfs:comment>
        <rdfs:label xml:lang="en">describes manuscript</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#describesVolume -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#describesVolume">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isDescribedBy"/>
        <rdfs:comment xml:lang="en">a record describes a volume of a manuscript in the case of volume cataloguing</rdfs:comment>
        <rdfs:label xml:lang="en">describes volume</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAccessRestriction -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAccessRestriction">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Collection"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#AccessRestriction"/>
        <rdfs:comment>a collection or a manuscript has access restriction</rdfs:comment>
        <rdfs:label xml:lang="en">has access restriction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAddress -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAddress">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Distributor"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Institution"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Publisher"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Address"/>
        <rdfs:comment xml:lang="en">it is the address of an institution</rdfs:comment>
        <rdfs:label xml:lang="en">has address</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAlternativeIdentifier -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAlternativeIdentifier">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#IdentificationInformation"/>
        <rdfs:comment xml:lang="en">(alternative identifier) contains an alternative or former structured identifier used for a manuscript, such as a former catalogue number. </rdfs:comment>
        <rdfs:label xml:lang="en">has Alternative Identifier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasArchRef -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasArchRef">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Fragment"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#RelatedMaterial"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#ArchRef"/>
        <rdfs:comment xml:lang="en">a fragment or a related material of a manuscript may contain other archival documents</rdfs:comment>
        <rdfs:label xml:lang="en">has archival reference</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAuthor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAuthor">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isAuthorOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Catalogue"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#MsItem"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Author"/>
        <rdfs:comment xml:lang="en">a catalogue or a manuscript or a manuscript work has an author</rdfs:comment>
        <rdfs:label xml:lang="en">has author</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasBibRef -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasBibRef">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Bibliography"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#BibRef"/>
        <rdfs:comment xml:lang="en">a bibliography contains one or more bibligraphic references</rdfs:comment>
        <rdfs:label xml:lang="en">has bibliographic reference</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasBibliography -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasBibliography">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Taxonomy"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Bibliography"/>
        <rdfs:comment xml:lang="en">a manuscript or a taxonomy has a bibliography</rdfs:comment>
        <rdfs:label xml:lang="en">has Bibliography</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasBinding -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasBinding">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#CodicologicalInfo"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Binding"/>
        <rdfs:comment xml:lang="en">codicological information include binding</rdfs:comment>
        <rdfs:label xml:lang="en">has binding</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasChangeDate -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasChangeDate">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#RevisionDesc"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Date"/>
        <rdfs:comment xml:lang="en">it is the date of the change</rdfs:comment>
        <rdfs:label xml:lang="en">has change date</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCodicologicalInfo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCodicologicalInfo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#CodicologicalInfo"/>
        <rdfs:comment xml:lang="en">it contains the description of the physical components of the manuscript</rdfs:comment>
        <rdfs:label xml:lang="en">has Codicological Information</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasConservationInstitution -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasConservationInstitution">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Collection"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Institution"/>
        <rdfs:comment xml:lang="en">a collection is conserved in an institution</rdfs:comment>
        <rdfs:label xml:lang="en">has conservation institution</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasContentItem -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasContentItem">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#MsItem"/>
        <rdfs:comment xml:lang="en">it is for each content item(text) contained in a manuscript</rdfs:comment>
        <rdfs:label xml:lang="en">has Content Item</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasContributor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasContributor">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isContributorOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Contributor"/>
        <rdfs:comment xml:lang="en">a manuscript has a contributor e.g. illustrator, traductor,..</rdfs:comment>
        <rdfs:label xml:lang="en">has contributor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCreationDate -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCreationDate">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Collection"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Date"/>
        <rdfs:comment xml:lang="en">it is for the creation date of a collection or a manuscript</rdfs:comment>
        <rdfs:label xml:lang="en">has creation Date</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCreationPlace -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCreationPlace">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Place"/>
        <rdfs:comment xml:lang="en">a manuscript is created or copied in a palce</rdfs:comment>
        <rdfs:label xml:lang="en">has Creation Place</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDecoration -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDecoration">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Decoration"/>
        <rdfs:comment xml:lang="en">a manuscript may have decorations</rdfs:comment>
        <rdfs:label xml:lang="en">has decoration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDigitizedVersion -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDigitizedVersion">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#DigitizedVersion"/>
        <rdfs:comment xml:lang="en">to establish a link to one or more digital representations of the described manuscripts</rdfs:comment>
        <rdfs:label xml:lang="en">has digitized version</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDimensions -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDimensions">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#CodicologicalInfo"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Extent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Dimensions"/>
        <rdfs:comment xml:lang="en">the codicological information of manuscript includes the dimensions of the manuscript or the extent includes the dimensions</rdfs:comment>
        <rdfs:label xml:lang="en">has dimensions</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasEncodingDesc -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasEncodingDesc">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Record"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#EncodingDesc"/>
        <rdfs:comment xml:lang="en">a manuscript record has encoding description</rdfs:comment>
        <rdfs:label xml:lang="en">has encoding description</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasExplicit -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasExplicit">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#MsItem"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Explicit"/>
        <rdfs:comment xml:lang="en">a work has an explicit</rdfs:comment>
        <rdfs:label xml:lang="en">has explicit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasExtent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasExtent">
