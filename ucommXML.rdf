        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Producer"/>
        <rdfs:comment xml:lang="en">the producer of the manuscript collection</rdfs:comment>
        <rdfs:label xml:lang="en">has producer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasPublicationInfo -->

