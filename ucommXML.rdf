        <rdfs:label xml:lang="en">is contained in  catalogue</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isContainedInCollection -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isContainedInCollection">
        <rdfs:comment xml:lang="en">a manuscript belongs to a collection</rdfs:comment>
        <rdfs:label xml:lang="en">is contained in collection</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isContributorOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isContributorOf">
        <rdfs:comment xml:lang="en">it is the contributor of the manuscript</rdfs:comment>
        <rdfs:label xml:lang="en">is contributor of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isCopiedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isCopiedBy">
        <rdfs:comment xml:lang="en">a manuscript is copied by a scribe</rdfs:comment>
        <rdfs:label xml:lang="en">is copied by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isDescribedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isDescribedBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Volume"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Record"/>
        <rdfs:comment xml:lang="en">Relates a volume to a catalogue or descriptive record that provides metadata about it.</rdfs:comment>
        <rdfs:label xml:lang="en">is described by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isDescribedByCatalogue -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isDescribedByCatalogue">
        <rdfs:comment xml:lang="en">a collection is described by a catalogue following an encoding standard</rdfs:comment>
        <rdfs:label xml:lang="en">is described by a catalogue</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isDescribedByRecord -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isDescribedByRecord">
        <rdfs:comment xml:lang="en">a manuscript is described by a record</rdfs:comment>
        <rdfs:label xml:lang="en">is described by record</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isSubjectOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isSubjectOf">
        <rdfs:comment xml:lang="en">a subject is a subject of a manuscript</rdfs:comment>
        <rdfs:label xml:lang="en">is subject of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isVolumeOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isVolumeOf">
        <rdfs:comment xml:lang="en">a volume is a volume of a manuscript</rdfs:comment>
        <rdfs:label xml:lang="en">is volume of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#usesLanguage -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#usesLanguage">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#LangUsage"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Language"/>
        <rdfs:comment xml:lang="en">a lang usage uses a  language</rdfs:comment>
        <rdfs:label xml:lang="en">uses language</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#HowShelved -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#HowShelved">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Institution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">refers to the system used to shelve a bibliographic item in the collections of the reporting organization for example shelved by title.</rdfs:comment>
        <rdfs:label xml:lang="en">how shelved</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAbstract -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAbstract">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">contains the text of the abstract or summary, the analytical summary, or an expanded version of the abstract</rdfs:comment>
        <rdfs:label xml:lang="en">has Abstract</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAccMat -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAccMat">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#CodicologicalInfo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">(accompanying material) gives details of any accompanying material closely associated with the manuscript, such as non-contemporary documents or fragments related to the manuscript at an earlier time (Related but not original material).</rdfs:comment>
        <rdfs:label xml:lang="en">has accompanying material</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAccessMethod -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAccessMethod">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#DigitizedVersion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Access method to the electronic resource.The methods defined are the main TCP/IP (Transmission Control Protocol/Internet Protocol) protocols.</rdfs:comment>
        <rdfs:label xml:lang="en">has Access Method</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAccruals -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAccruals">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">This is for information regarding planned enhancements to the manuscript.</rdfs:comment>
        <rdfs:label xml:lang="en">has Accruals</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAcqInfo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAcqInfo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">This concerns information relating to how documentary units entered the preservation institution. That is to say, how the manuscript was acquired by the institution, for example, through a donation, purchase, bequest, deposit, administrative transfer, date of entry, previous owner, administrative provenance, etc.</rdfs:comment>
        <rdfs:label xml:lang="en">has Acquisition Information</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAddressLine -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAddressLine">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Address"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">each address  contains one or more postal address line.</rdfs:comment>
        <rdfs:label xml:lang="en">has address Line</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAffiliation -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAffiliation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The name of an organization, institution, etc. with which the entity was associated at the time that the resource was created.</rdfs:comment>
        <rdfs:label xml:lang="en">has affiliation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAlphabet -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAlphabet">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Language"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Specifies the alphabet, script, or notation system that is used in the resource. This includes specialized scripts, typefaces, or codes (e.g., Arabic alphabet, Arabic numerals, ASCII, bar code, BCD, braille, ciphers, Cyrillic alphabet, EBCDIC, Fraktur, Greek alphabet, Hebrew alphabet, hieroglyphics, pictograms, Roman alphabet, Roman numerals, or logarithmic or semilogarithmic graphing, etc.).</rdfs:comment>
        <rdfs:label xml:lang="en">has Alphabet</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAlternativeForm -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAlternativeForm">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">It serves to indicate that there are other forms, versions or media of the same document, for example: a digitization of the manuscript, a microfilm copy, a printed edition, a transcription, a translation, a photographic reproduction.</rdfs:comment>
        <rdfs:label xml:lang="en">has Alternative Form</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAlternativeName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAlternativeName">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">it is an alternative title which is a varying form of the title</rdfs:comment>
        <rdfs:label xml:lang="en">has Alternative Name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAngleAlef -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAngleAlef">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#WrittingStyle"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">This is the angle of inclination of the letter alif</rdfs:comment>
        <rdfs:label xml:lang="en">has Angle Alef</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAngleKaf -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAngleKaf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#WrittingStyle"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>This is the angle of inclination of the letter kaf</rdfs:comment>
        <rdfs:label xml:lang="en">has Angle Kaf</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAppraisal -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAppraisal">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">This is for information relating to any sorting and disposal carried out by the conservation institution.</rdfs:comment>
        <rdfs:label xml:lang="en">has appraisal</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasArchRefValue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasArchRefValue">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#ArchRef"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">This is a reference to an external archival reference to other documents described online, here to separate documents</rdfs:comment>
        <rdfs:label xml:lang="en">has archival reference</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasArrangement -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasArrangement">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">This is for all information about the structure, order, or classification plan of the description unit.</rdfs:comment>
        <rdfs:label xml:lang="en">has arrangement</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAuthefilNumber -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAuthefilNumber">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Institution"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Person"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Place"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Subject"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Unique identifier of the institution within the authority file</rdfs:comment>
        <rdfs:label xml:lang="en">has authfil number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAuthority -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAuthority">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Institution"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Person"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Subject"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">it indicates the source of the controlled vocabulary used for the subject heading for example lcsh, RVM, CSH,..or  the authority file used</rdfs:comment>
        <rdfs:label xml:lang="en">has Authority</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAuthorizedUsers -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAuthorizedUsers">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#AccessRestriction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Class of users or specific individuals (by name or title) to whom the restrictions do not apply.</rdfs:comment>
        <rdfs:label xml:lang="en">has authorized users</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAvailabilityDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAvailabilityDate">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#AccessRestriction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date when the resource changes its access status, e.g., when it becomes freely available. Preferred structure for the date is according to Date and Time (ISO 8601): yyyymmdd.</rdfs:comment>
        <rdfs:label xml:lang="en">has availability date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasBibRefValue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasBibRefValue">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#BibRef"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">it is the name of the bibliographic reference</rdfs:comment>
        <rdfs:label xml:lang="en">has bibliographic reference</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasBindingInfo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasBindingInfo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Binding"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">it is an abstract of the binding in the form of a paragraph</rdfs:comment>
        <rdfs:label xml:lang="en">has Binding Information</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasBioghist -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasBioghist">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">This is for the information relating to the producer of the collections (individual, family, or community) necessary for a proper understanding of the documents described.</rdfs:comment>
        <rdfs:label xml:lang="en">has bioghist</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasBoard -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasBoard">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Binding"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">it is the board contained in the cover. The board = the “flat” of the book: The solid piece found at the front and back, onto which the leather or parchment that covers the binding is glued; ; it can be made of wood or cardboard.</rdfs:comment>
        <rdfs:label xml:lang="en">has board</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCalendar -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCalendar">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Date"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#NMTOKEN"/>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>chinese</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>gregorian</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>hebrew</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first>islamic</rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                <rdf:first>julian</rdf:first>
                                                                <rdf:rest>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                        <rdf:first>revolutionnaire</rdf:first>
                                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                    </rdf:Description>
                                                                </rdf:rest>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </owl:oneOf>
                    </rdfs:Datatype>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">the calendar used in the date</rdfs:comment>
        <rdfs:label xml:lang="en">has calendar</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCatalogingLanguage -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCatalogingLanguage">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Record"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#language"/>
        <rdfs:comment xml:lang="en">The language of the text of the record. it Contains the language(s) of the metadata record.</rdfs:comment>
        <rdfs:label xml:lang="en">has cataloguing language</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCatchWords -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCatchWords">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#CodicologicalInfo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">it describes the system used to ensure correct ordering of the quires or similar making up a codex, incunable, or other object typically by means of annotations at the foot of the page.</rdfs:comment>
        <rdfs:label xml:lang="en">has catch words</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasChangeItem -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasChangeItem">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#RevisionDesc"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">it describes the nature of the changes.</rdfs:comment>
        <rdfs:label xml:lang="en">has change item</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasColophon -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasColophon">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#MsItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">contains the colophon of an item: that is, a statement providing information regarding the date, place, agency, or reason for production of the manuscript</rdfs:comment>
        <rdfs:label xml:lang="en">has colophon</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasColorContent -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasColorContent">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Support"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Color characteristics of the content of a resource. Achromatic values (white, gray, and black) are considered to be colors.</rdfs:comment>
        <rdfs:label xml:lang="en">has color content</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasColumns -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasColumns">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Layout"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">specifies the number of columns present on a page</rdfs:comment>
        <rdfs:label xml:lang="en">has columns</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasConditioning -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasConditioning">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#CodicologicalInfo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">It is for the packaging (conditionning) carried out before the manuscript entered the conservation institution.</rdfs:comment>
        <rdfs:label xml:lang="en">has conditioning</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCorporateNameType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCorporateNameType">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#CorporateSubject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">This type of community name entry has three values: 0: Inverted name; 1: Jurisdiction name; 2: Name in direct order</rdfs:comment>
        <rdfs:label xml:lang="en">has Corporate Name Type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCountryCode -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCountryCode">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#CatalogueIdentifier"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Institution"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Country code of the producing institution</rdfs:comment>
        <rdfs:label xml:lang="en">has country code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCountryEncoding -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCountryEncoding">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Catalogue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#NMTOKEN"/>
        <rdfs:comment xml:lang="en">it Indicates the country of the institution producing the file (e.g., FR for France, US for United States)</rdfs:comment>
        <rdfs:label xml:lang="en">has country encoding</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCover -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCover">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Binding"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">a manuscript has a cover</rdfs:comment>
        <rdfs:label xml:lang="en">has Cover</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCoverage -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCoverage">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Spatiotemporal scope or coverage of the manuscript</rdfs:comment>
        <rdfs:label xml:lang="en">has Coverage</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCreationInfo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCreationInfo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Catalogue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">This is for information on the initial encoding of the finding aid; it must always specify: the format version and the possible use of a schema; the cataloging tool, in the case of ongoing cataloging; the details of any conversion (source, format, service provider, etc.) and may also mention the name of the encoder and the date of encoding.</rdfs:comment>
        <rdfs:label xml:lang="en">has creation information</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDate">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Institution"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Person"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#PersonSubject"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Used to parse a date (for example a birth date) included for the purpose of distinguishing individuals with the same name.</rdfs:comment>
        <rdfs:label xml:lang="en">has date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDateCreation -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDateCreation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Record"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">The date or date and time when the original record was first created.</rdfs:comment>
        <rdfs:label xml:lang="en">has creation date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDateEncoding -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDateEncoding">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Catalogue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#NMTOKEN"/>
        <rdfs:comment xml:lang="en">Standard format for dates (e.g., 2025-12-15 for December 15, 2025)</rdfs:comment>
        <rdfs:label xml:lang="en">has date encoding</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDateValue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDateValue">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Date"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">it is the value of the data element</rdfs:comment>
        <rdfs:label xml:lang="en">has date value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDecorationInfo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDecorationInfo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Decoration"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">It contains description informations of the decoration of a manuscript</rdfs:comment>
        <rdfs:label xml:lang="en">has decoration information</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDecorationNote -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDecorationNote">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Binding"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Decoration"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">it is used to describe the decorative elements associated with the book binding.</rdfs:comment>
        <rdfs:label xml:lang="en">has decoration note</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDensity -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDensity">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#WrittingStyle"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The number of letters written over a given distance. That is to say, how close the writing is, and high density = very close writing.</rdfs:comment>
        <rdfs:label xml:lang="en">has density</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDescription -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDescription">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#DigitizedVersion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">it is the description of the digital ressource. In mods, It indicates how the document attained its digital form; its possible values ​​are: born digital: the resource was born digital and will remain digital; reformatted digital: an original analog document was directly digitized; digitized microfilm: the file comes from the digitization of a microfilm, itself an analog copy; digitized other analog: the resource comes from the digitization of a secondary analog copy.</rdfs:comment>
        <rdfs:label xml:lang="en">has description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDescriptionRules -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDescriptionRules">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Record"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Designates the rules used for the content of the description, it is the code for or the title of the description rules used in creating the record. The subfield may also be used to record the use of AACR 2-based manuals.</rdfs:comment>
        <rdfs:label xml:lang="en">has description rules</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDiameter -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDiameter">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Dimensions"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">the diameter dimension</rdfs:comment>
        <rdfs:label xml:lang="en">has diameter</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDimensionsInfo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDimensionsInfo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Dimensions"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">the textual value of dimensions Tag (often after folding, binding, etc.).</rdfs:comment>
        <rdfs:label xml:lang="en">has dimensions info</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDocumentType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDocumentType">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">It is used to describe the type or form of a resource. This is for the type of resource to be described, Nature or genre of the resource content e.g. handwritten text.</rdfs:comment>
        <rdfs:label xml:lang="en">has document type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasEmail -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasEmail">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Distributor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">it is the email of an entity</rdfs:comment>
        <rdfs:label xml:lang="en">has email</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasEncodingAnalog -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasEncodingAnalog">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#CatalogueIdentifier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Indicates the equivalence with another metadata standard (dc, marc, etc)</rdfs:comment>
        <rdfs:label xml:lang="en">has encoding analog</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasEra -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasEra">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Date"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#NMTOKEN"/>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>ce</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </owl:oneOf>
                    </rdfs:Datatype>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The era attribute is for the corresponding era in a calendar. Most of the time, the values calendar=&quot;gregorian&quot; and era=&quot;ce&quot; (Common Era of the Gregorian calendar) are used.</rdfs:comment>
        <rdfs:label xml:lang="en">has era</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasExplicitText -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasExplicitText">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Explicit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">it is the text of the explicit</rdfs:comment>
        <rdfs:label xml:lang="en">has explicit text</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasExtentInfo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasExtentInfo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Extent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>it is the textual value of extent</rdfs:comment>
        <rdfs:label xml:lang="en">has extent information</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasFileName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasFileName">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#CatalogueIdentifier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">File name describing the catalogue</rdfs:comment>
        <rdfs:label xml:lang="en">has file name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasFindAidStatus -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasFindAidStatus">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Catalogue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#NMTOKEN"/>
        <rdfs:comment xml:lang="en">It indicates the status of the finding aid or catalog, for example: incomplete or provisional.</rdfs:comment>
        <rdfs:label xml:lang="en">has find aid status</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasFirstName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasFirstName">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">it is the first name of the person</rdfs:comment>
        <rdfs:label xml:lang="en">has first name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasFoldingFormat -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasFoldingFormat">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Support"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The result of folding a printed sheet to form a gathering of leaves (e.g., a sheet folded once to form a folio, twice to form a quarto, three times to form an octavo).</rdfs:comment>
        <rdfs:label xml:lang="en">has folding format</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasFoliation -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasFoliation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#CodicologicalInfo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">it describes the numbering system or systems (numerotation) used to count the leaves or pages in a codex or similar object</rdfs:comment>
        <rdfs:label xml:lang="en">has foliation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasFragmentInfo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasFragmentInfo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Fragment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">it gives information about the Separate documents</rdfs:comment>
        <rdfs:label xml:lang="en">has fragment information</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasFunction -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasFunction">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Institution"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Producer"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">it is the role played by a person or institution e.g: producer,author,..</rdfs:comment>
        <rdfs:label xml:lang="en">has function</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasGeneration -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasGeneration">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Support"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">for the The relationship between an original carrier and the carrier of a reproduction made from the original (e.g., a first generation camera master, a second generation printing master). It indicates whether the medium is original or a reproduction, for example original: the medium is the original written or created by the copyist; print master or other: the record describes a copy or reproduction (for example a facsimile, microfilm, or print).</rdfs:comment>
        <rdfs:label xml:lang="en">has generation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasGenre -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasGenre">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Subject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">it explains what form the documents on this subject take</rdfs:comment>
        <rdfs:label xml:lang="en">has genre</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasGeographic -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasGeographic">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Subject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Indicates the geographical location to which the subject is attached. It answers the question: &quot;Where?&quot;</rdfs:comment>
        <rdfs:label xml:lang="en">has geographic</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasGraphic -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasGraphic">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Image"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">(graphic) indicates the location of an embedded image, illustration, or diagram.</rdfs:comment>
        <rdfs:label xml:lang="en">has graphic</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasHeight -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasHeight">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Dimensions"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">the height dimension</rdfs:comment>
        <rdfs:label xml:lang="en">has height</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasID -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasID">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#IdentificationInformation"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Taxonomy"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">it is for the id value</rdfs:comment>
        <rdfs:label xml:lang="en">has identifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasIdentifier -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasIdentifier">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#CatalogueIdentifier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">gives a unique identifier to the file describing the catalogue</rdfs:comment>
        <rdfs:label xml:lang="en">has identifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasIncipitText -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasIncipitText">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Incipit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">it is the text of the incipit</rdfs:comment>
        <rdfs:label xml:lang="en">has incipit text</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasInk -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasInk">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#WrittingStyle"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">describes the shade or type of ink, for example brown, or other writing tool, for example a pencil.</rdfs:comment>
        <rdfs:label xml:lang="en">has Ink</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasJurisdiction -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasJurisdiction">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#AccessRestriction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The name of the person, institution, or institutional role responsible for imposing and/or enforcing access conditions, and to whom requests or appeals regarding these restrictions may be addressed.</rdfs:comment>
        <rdfs:label xml:lang="en">has jurisdiction</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasKey -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasKey">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Place"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">the key code of the country, for example: for Danemark, its key code: DK</rdfs:comment>
        <rdfs:label xml:lang="en">has key</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasKuniya -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasKuniya">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">contains an additional name component, such as a nickname, epithet, or alias, or any other descriptive phrase used within a personal name.</rdfs:comment>
        <rdfs:label xml:lang="en">has kuniya</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLangCode -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLangCode">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Language"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#language"/>
        <rdfs:comment xml:lang="en">​​provides a language code</rdfs:comment>
        <rdfs:label xml:lang="en">has lang code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLangEncoding -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLangEncoding">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Catalogue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#NMTOKEN"/>
        <rdfs:comment xml:lang="en">Code for the main language of the file (e.g., lat = Latin, eng = English)</rdfs:comment>
        <rdfs:label xml:lang="en">has lang encoding</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLangUsageValue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLangUsageValue">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#LangUsage"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">the lang usage value</rdfs:comment>
        <rdfs:label xml:lang="en">has lang usage value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLanguageName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLanguageName">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Language"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#language"/>
        <rdfs:comment xml:lang="en">it is the name of the language</rdfs:comment>
        <rdfs:label xml:lang="en">has language name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLastName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLastName">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">it is the last name of a person</rdfs:comment>
        <rdfs:label xml:lang="en">has last name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLayoutInfo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLayoutInfo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Layout"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">it is for the arrangement of text, it is the value of the layout element</rdfs:comment>
        <rdfs:label xml:lang="en">has layout information</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLayoutTool -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLayoutTool">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Layout"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">it specifies the tool used for the layout</rdfs:comment>
        <rdfs:label xml:lang="en">has layout tool</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLegalAuthority -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLegalAuthority">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#AccessRestriction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The law or legal authority that imposes the restriction. It specifies the rule on which access is limited, for example, Article 35 of the French Archives Law. This means that access is limited by French law.</rdfs:comment>
        <rdfs:label xml:lang="en">has legal authority</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLegalStatusInfo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLegalStatusInfo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#LegalStatus"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">It indicates, using standardized textual values, whether the described document is considered patrimonial or non-patrimonial).</rdfs:comment>
        <rdfs:label xml:lang="en">has legal status information</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLength -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLength">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Dimensions"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">the length dimension</rdfs:comment>
        <rdfs:label xml:lang="en">has length</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLineHeight -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLineHeight">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Layout"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">it specifies the height of lines</rdfs:comment>
        <rdfs:label xml:lang="en">has line height</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLink -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLink">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#ArchRef"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#BibRef"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#DigitizedVersion"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">it is the link to the digitized manuscript, or to a bibliographic reference</rdfs:comment>
        <rdfs:label xml:lang="en">has link</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLinkTitle -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLinkTitle">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#DigitizedVersion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">the title of the link as text</rdfs:comment>
        <rdfs:label xml:lang="en">has link title</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLocus -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLocus">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Explicit"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Incipit"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Layout"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#MsItem"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">defines a location within a manuscript, manuscript part, typically as a (possibly discontinuous) sequence of folio references</rdfs:comment>
        <rdfs:label xml:lang="en">has locus</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasMainAgencyCode -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasMainAgencyCode">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#CatalogueIdentifier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#NMTOKEN"/>
        <rdfs:comment xml:lang="en">It indicates the institution responsible for publishing the catalogue.</rdfs:comment>
        <rdfs:label xml:lang="en">has main agency code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasMarginalAdditions -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasMarginalAdditions">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">contains a description of significant additions found in a manuscript, such as marginal glosses or other annotations. it refers to textual or figurative elements present in the margins of the described manuscript and related to its content. These elements may be contemporary with or later than the document&apos;s production.</rdfs:comment>
        <rdfs:label xml:lang="en">has marginal additions</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasMaterial -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasMaterial">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Support"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">It describes the material or materials used to produce a manuscript. that is to say, the material that was primarily used to make the support. It is a particular material for a component or element of the support (ribbon, binding, ornament…). Or used for a short project-defined name for the material composing the majority of the support.</rdfs:comment>
        <rdfs:label xml:lang="en">has material</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasMedia -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasMedia">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Support"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Describes the medium, that is, the material or substance applied to the support: ink, paint, gold leaf,  to create the text or decoration.</rdfs:comment>
        <rdfs:label xml:lang="en">has media</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasMediaType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasMediaType">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Media type reflects the general type of intermediation device required to view, play, run, etc., the content of a manuscript</rdfs:comment>
        <rdfs:label xml:lang="en">has media type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasMsItemID -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasMsItemID">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#MsItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">it is the ID of the manuscript item</rdfs:comment>
        <rdfs:label xml:lang="en">has msItem ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasName">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Contributor"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Distributor"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Institution"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Person"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Producer"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Publisher"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Subject"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">it is the full name of an entity e.g: institution, person,..</rdfs:comment>
        <rdfs:label xml:lang="en">has Name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasNameTranscription -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasNameTranscription">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">the Transcription of the name</rdfs:comment>
        <rdfs:label xml:lang="en">has name transcription</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasNormalizedDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasNormalizedDate">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Date"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">NormalizedDate is used for indexing and search purposes. Regardless of the values entered in CALENDAR and ERA, this date is always expressed according to the extended ISO 8601 standard (i.e., in the Gregorian calendar), using dashes or not depending on the tool used: YYYYMMDD/YYYYMMDD or YYYY-MM-DD/YYYY-MM-DD.</rdfs:comment>
        <rdfs:label xml:lang="en">has normalized date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasNormalizedName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasNormalizedName">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Institution"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Person"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Place"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">it is for the normalized version of the name</rdfs:comment>
        <rdfs:label xml:lang="en">has normalized name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasNormalizedTopic -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasNormalizedTopic">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Subject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">to give a standardized form of the topic name</rdfs:comment>
        <rdfs:label xml:lang="en">has normalized topic</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasNote -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasNote">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#IdentificationInformation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">a note that explains the alternatif identifier</rdfs:comment>
        <rdfs:label xml:lang="en">has note</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasNumber -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasNumber">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#MsItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">it is used to number or label an msItem according to its order within the manuscript</rdfs:comment>
        <rdfs:label xml:lang="en">has number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasOrigin -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasOrigin">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Record"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Shows the origin or provenance of the record.</rdfs:comment>
        <rdfs:label xml:lang="en">has origin</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasOriginalDimensions -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasOriginalDimensions">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Support"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">This is the dimension of the original parchment/scroll before folding and binding</rdfs:comment>
        <rdfs:comment xml:lang="en">an extent or codicological information has dimensions</rdfs:comment>
        <rdfs:label xml:lang="en">has original dimensions</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasOriginalLanguage -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasOriginalLanguage">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Language"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">if it is a translation, we put the language code of the original language of the document.</rdfs:comment>
        <rdfs:label xml:lang="en">has original language</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasOriginalLocation -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasOriginalLocation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">provides information on the original document when the notice describes a reproduction, allowing you to know where the original is located and how to identify it. It is used when the document you are describing is not the original, but a reproduction</rdfs:comment>
        <rdfs:label xml:lang="en">has original location</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasPhysicalAccessProvisions -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasPhysicalAccessProvisions">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#AccessRestriction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Arrangements required for physical access. Such arrangements may change from time to time.</rdfs:comment>
        <rdfs:label xml:lang="en">has physical access provisions</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasPhysicalLocation -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasPhysicalLocation">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Collection"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#anyURI"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Information allowing the identification of the place where the described manuscripts are stored.

This may include, for example, the indication that a collection is deposited in another institution, the name or number of a building or storage area, or any other physical location detail, particularly when this location affects access.</rdfs:comment>
        <rdfs:label xml:lang="en">has pysical location</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasPostCode -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasPostCode">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Address"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">contains a numeric or alphanumeric code that forms part of the postal address and is used to simplify the sorting or distribution of mail.</rdfs:comment>
        <rdfs:label xml:lang="en">has post code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasPreferredCitation -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasPreferredCitation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Collection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">To provide information on the form to be used when citing the described collection. This element is particularly useful in the description of the collection but may also be used within the Component element (a manuscript).</rdfs:comment>
        <rdfs:label xml:lang="en">has preferred citation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasProcessInfo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasProcessInfo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">To make information on the processing of documentary units and the control of their descriptions accessible to the public. This information may relate to: updates to the format of digital documents to ensure their accessibility;preservation treatments carried out (disinfection, cleaning, dusting);the management of accessions and the cataloging of documents;the control of descriptions (information on the creation and revision of the record description).</rdfs:comment>
        <rdfs:label xml:lang="en">has process information</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasProductionTechnique -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasProductionTechnique">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#CodicologicalInfo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">for the technique used for the creation of the manuscript, that is to say, how the object was made.</rdfs:comment>
        <rdfs:label xml:lang="en">has production technique</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasProjectDesc -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasProjectDesc">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#EncodingDesc"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">describes in detail the purpose or objective of encoding an electronic file, as well as any other relevant information about how it was constructed or collected.</rdfs:comment>
        <rdfs:label xml:lang="en">has project description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasProvenance -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasProvenance">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">It describes its previous history, that is to say, all the stages in the manuscript&apos;s life after its creation but before its final acquisition by the current institution.</rdfs:comment>
        <rdfs:label xml:lang="en">has provenance</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasPubPlace -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasPubPlace">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#PublicationInfo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A place associated with the publication event.</rdfs:comment>
        <rdfs:label xml:lang="en">has publication place</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasPublisher -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasPublisher">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Catalogue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The name of the entity that published  the resource.</rdfs:comment>
        <rdfs:label xml:lang="en">has publisher</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasQuireInfo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasQuireInfo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Quire"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">the information of the quire or the quires of the manuscript</rdfs:comment>
        <rdfs:label xml:lang="en">has Quire Info</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRatio -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRatio">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#WrittingStyle"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">This corresponds to the ratio between the height and width of the letters to analyze the proportion and elegance of the calligraphic style, for example: 1:1 means square letters (width = height); 2:1 (tall and vertical); 1:2 (very elongated horizontally)</rdfs:comment>
        <rdfs:label xml:lang="en">has ratio</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRecordID -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRecordID">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Record"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Contains the system control number assigned by the organization creating, using, or distributing the record.</rdfs:comment>
        <rdfs:label xml:lang="en">has record id</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRecordInfo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRecordInfo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Record"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">contains details about the record</rdfs:comment>
        <rdfs:label xml:lang="en">has record information</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRecordTitle -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRecordTitle">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Record"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">the title of the record</rdfs:comment>
        <rdfs:label xml:lang="en">has record title</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRecordingTechnique -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRecordingTechnique">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Support"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Means or technique by which information was recorded in or on the material base (e.g., handwritten, engraved, punched, pressed, cut, molded, thermofax, x-ray)</rdfs:comment>
        <rdfs:label xml:lang="en">has recording technique</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasReformattingQuality -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasReformattingQuality">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#DigitizedVersion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">It indicates the purpose or intended use of a digital resource, that is, why it was digitized and at what quality. The &quot;access&quot; value designates a resource intended for online consultation or quick reference, but not suitable for long-term preservation. The &quot;preservation&quot; value corresponds to a resource created to preserve the original over the long term, with high quality. Finally, the &quot;replacement&quot; value designates a digital resource of sufficient quality to replace the original if it is lost, damaged, or destroyed.</rdfs:comment>
        <rdfs:label xml:lang="en">has reformatting quality</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRelatedEncoding -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRelatedEncoding">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Catalogue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The RELATEDENCODING attribute should only be set if you want to provide the equivalent of an EAD element in another format using the ENCODINGANALOG attribute. For example, if you decide to create an equivalence to the Dublin Core format for an OAI data export, the value to use is &quot;dc&quot;.</rdfs:comment>
        <rdfs:label xml:lang="en">has related encodinging</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRelatedMaterialInfo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRelatedMaterialInfo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#RelatedMaterial"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">it gives information about the related documents</rdfs:comment>
        <rdfs:label xml:lang="en">has related material information</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRelationship -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRelationship">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#DigitizedVersion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Relationship between a networked electronic resource at the location identified and the resource described in the record as a whole. It means that if  the record describes a networked electronic or non-electronic  resource.</rdfs:comment>
        <rdfs:label xml:lang="en">has relationship</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRepositoryEncoding -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRepositoryEncoding">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Catalogue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#NMTOKEN"/>
        <rdfs:comment xml:lang="en">Standardized identifier for the repository or institution (e.g., BNF = Bibliothèque nationale de France)</rdfs:comment>
        <rdfs:label xml:lang="en">has repository encoding</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRestrictionInfo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRestrictionInfo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#AccessRestriction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">a manuscript has restriction information</rdfs:comment>
        <rdfs:label xml:lang="en">has restriction information</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRestrictionOrNo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRestrictionOrNo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">It indicates whether an access restriction is applied to the manuscript. The value #: No information provided, 0: no restriction; 1: Restrictions apply. Details about the restrictions are given in the AccessRestrict class.</rdfs:comment>
        <rdfs:label xml:lang="en">has restriction Or No</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRole -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRole">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Contributor"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Institution"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Person"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Place"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The role played by the entity in the resource e.g. illustrator, traductor,production palce, copy place,..</rdfs:comment>
        <rdfs:label xml:lang="en">has role</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRuledLines -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRuledLines">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Layout"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">(ruling lines) specifies the number of ruling lines present per column.</rdfs:comment>
        <rdfs:label xml:lang="en">has ruled lines</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasScope -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasScope">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#WrittingStyle"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">provides attributes to describe, in general terms, the scope of an element’s application. there are 3 suggested values: sole: only this particular feature is used throughout the document; major:this feature is used through most of the document; minor: this feature is used occasionally through the document</rdfs:comment>
        <rdfs:label xml:lang="en">has scope</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasScopeContent -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasScopeContent">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">For additional information beyond that contained in the Description and Identification element, relating to the content, scope, subject, form, nature, and genetic state of the manuscript, such as incipit and explicit text, which are given as quotations in blockquote</rdfs:comment>
        <rdfs:label xml:lang="en">has scope content</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasScribeNumber -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasScribeNumber">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">specifies the number of different hands (scribes) that could be identified in the manuscript.</rdfs:comment>
        <rdfs:label xml:lang="en">has scribe number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasScript -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasScript">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#WrittingStyle"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">characterizes the calligraphy or particular writing style used by that hand, for example English, chancery, Italian script, etc.</rdfs:comment>
        <rdfs:label xml:lang="en">has script</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasScriptEncoding -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasScriptEncoding">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Catalogue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#NMTOKEN"/>
        <rdfs:comment xml:lang="en">Encoding for the writing system used (e.g., Latn = Latin script, Arab = Arabic script</rdfs:comment>
        <rdfs:label xml:lang="en">has script encoding</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasSeal -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasSeal">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#CodicologicalInfo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">contains the description of a seal or similar object attached to the manuscript.</rdfs:comment>
        <rdfs:label xml:lang="en">has seal</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasSettlement -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasSettlement">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Address"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">(settlement place) contains the name of a settlement place such as a city, town or village, identified as a unique geopolitical or administrative unit.</rdfs:comment>
        <rdfs:label xml:lang="en">has settlement</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasShelvingLocation -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasShelvingLocation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Institution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Shelving location of the item within the collection of the holding organization. It may be used to indicate the physical location within a sublocation; for example, reference alcove, oversize shelving</rdfs:comment>
        <rdfs:label xml:lang="en">has shelving location</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasShelvingOrder -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasShelvingOrder">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Institution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">It indicates the numbering system used to shelve the copy; that is, the numbering system the library uses to physically classify this document.</rdfs:comment>
        <rdfs:label xml:lang="en">has shelving order</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasSourceCodeLang -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasSourceCodeLang">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Language"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">It indicates the origin of the language codes used in the field.</rdfs:comment>
        <rdfs:label xml:lang="en">has source code lang</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasSponsor -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasSponsor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Catalogue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">for the names of the people or institutions that supported, financed or organised all or part of the process of creating and disseminating the finding aid (catalogue)</rdfs:comment>
        <rdfs:label xml:lang="en">has sponsor</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasState -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasState">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#CodicologicalInfo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">contains the description of the physical condition of the manuscript and its alterations.</rdfs:comment>
        <rdfs:label xml:lang="en">has state</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasStatementOfResponsibility -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasStatementOfResponsibility">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">It is the text appearing on the document that indicates the people or organizations that participated in the creation of the work. It is reproduced exactly as it appears in the source of information, without modification or standardization.</rdfs:comment>
        <rdfs:label xml:lang="en">has statement Of responsibility</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasStreet -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasStreet">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Address"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A complete street address including a name or number identifying a building and the name of the street or road on which it is located.</rdfs:comment>
        <rdfs:label xml:lang="en">has street</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasSubTitle -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasSubTitle">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Catalogue"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Collection"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">for the subtitle or complement to the title</rdfs:comment>
        <rdfs:label xml:lang="en">has sub title</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasSubordinateUnit -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasSubordinateUnit">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Institution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">It is an internal part (internal division) of a main institution, for example the Department of Manuscripts is a subordinate unit that depends on the BNF.</rdfs:comment>
        <rdfs:label xml:lang="en">has subordinate unit</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasSurface -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasSurface">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Image"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">define a surface written as a rectangle described by its spatial coordinates, possibly grouping one or more graphical representations of this space and interesting rectangular areas within it.</rdfs:comment>
        <rdfs:label xml:lang="en">has surface</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasTemporal -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasTemporal">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Subject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Indicates the historical period to which the subject applies. It answers the question: &quot;when?&quot;</rdfs:comment>
        <rdfs:label xml:lang="en">has temporal</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasTermsOfAddress -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasTermsOfAddress">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">for titles and enumeration associated with a name, such as Jr., II, etc.</rdfs:comment>
        <rdfs:label xml:lang="en">has terms of address</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasTitle -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasTitle">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Catalogue"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Collection"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Volume"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">the  title of a work like: catalogue, collection, manuscript, Volume,....</rdfs:comment>
        <rdfs:label xml:lang="en">has title</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasTopic -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasTopic">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Subject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#short"/>
        <rdfs:comment xml:lang="en">Describes the particular aspect, angle, or theme from which the subject is treated. It answers the question: &quot;What exactly?&quot;</rdfs:comment>
        <rdfs:label xml:lang="en">has topic</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasTranscribingAgency -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasTranscribingAgency">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Record"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">code or the name of the organization that transcribed the record into machine-readable form.</rdfs:comment>
        <rdfs:label xml:lang="en">has transcribing agency</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasType">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#AccessRestriction"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#City"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Date"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Decoration"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#DigitizedVersion"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Dimensions"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Explicit"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Extent"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#IdentificationInformation"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Incipit"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#LegalStatus"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#MsItem"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Support"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The electronic format type, or the data representation, of the resource. 
that is to say, to indicate the exact electronic format of the digital resource, for example image/jpeg, application/pdf, text/xml, audio/mpeg, video/mp4</rdfs:comment>
        <rdfs:comment xml:lang="en">for the type of the date, for example: approximative date</rdfs:comment>
        <rdfs:comment xml:lang="en">il also used for the type of the extent, for example unit number, duration,..</rdfs:comment>
        <rdfs:comment xml:lang="en">it is also used for the physical medium in which the manuscript is presented, for example in the form of a scroll or codex</rdfs:comment>
        <rdfs:comment>il also indicates the nature of the document owner.</rdfs:comment>
        <rdfs:comment>it also Identifies what type of access condition is recorded foe eg restriction on access, use and reproduction</rdfs:comment>
        <rdfs:label xml:lang="en">has type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasURL -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasURL">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Institution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">The URI links to the repository that holds the item (regardless of whether the item is analog or digital)</rdfs:comment>
        <rdfs:label xml:lang="en">has url</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasUniformTitle -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasUniformTitle">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Collection"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#UniformTitleSubject"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">it is to add a uniform title of the title</rdfs:comment>
        <rdfs:label xml:lang="en">has a uniform title</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasUnit -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasUnit">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Dimensions"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Extent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Indicates the unit of measurement (e.g. inches, cm, grams, liters, minutes) for the value(s) in the extent element. It is used to provide more information regarding extent by separating out unit type.</rdfs:comment>
        <rdfs:label xml:lang="en">has unit</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasUseRestriction -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasUseRestriction">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Collection"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">This is for information indicating whether the reproduction or use of a documentary unit is subject to conditions</rdfs:comment>
        <rdfs:label xml:lang="en">has use restriction</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasVolume -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasVolume">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Collection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">the volumes of a collection</rdfs:comment>
        <rdfs:label xml:lang="en">has volume</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasVolumeNumber -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasVolumeNumber">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Volume"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Specifies the ordinal number or designation of a volume within a manuscript, such as Volume 1, Volume 2, or Tome 3.</rdfs:comment>
        <rdfs:label xml:lang="en">has volume number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasVolumeType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasVolumeType">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Volume"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Specifies the type or role of a volume within a manuscript, such as main, secondary, supplementary, or other material subdivision.&quot;</rdfs:comment>
        <rdfs:label xml:lang="en">has volume type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasWaterMark -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasWaterMark">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Support"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">It contains a word or expression describing a watermark or a similar mark.</rdfs:comment>
        <rdfs:label xml:lang="en">has water mark</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasWidth -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasWidth">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Dimensions"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">the width dimension</rdfs:comment>
        <rdfs:label xml:lang="en">has width</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasWrittenLines -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasWrittenLines">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Layout"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">(writing lines) specifies the number of lines written per column.</rdfs:comment>
        <rdfs:label xml:lang="en">has written lines</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isAbsent -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isAbsent">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">To report the permanent absence of the described manuscript (confirmed disappearance, accidental destruction, permanent transfer or return to its owner)</rdfs:comment>
        <rdfs:label xml:lang="en">is absent</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isDefective -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isDefective">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Explicit"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Incipit"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">indicates whether the incipit or explicit text is defective, i.e. incomplete through loss or damage.</rdfs:comment>
        <rdfs:label xml:lang="en">is defective</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isNormalized -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isNormalized">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Collection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">to designate or not secondary collection access points (uniform titles, personal names, etc.)</rdfs:comment>
        <rdfs:label xml:lang="en">is normalized or non</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isOriginal -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isOriginal">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Binding"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">describes if the binding is original or no, it is booleen</rdfs:comment>
        <rdfs:label xml:lang="en">is Original</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isTranslation -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isTranslation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Language"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">It indicates whether the manuscript is a translation or contains a translation</rdfs:comment>
        <rdfs:label xml:lang="en">is translation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#notAfter -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#notAfter">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Date"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">The latest possible date, the event (writing, copying, creation, etc.) cannot be later  than this date</rdfs:comment>
        <rdfs:label xml:lang="en">not after</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#notBefore -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#notBefore">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Date"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">The earliest possible date, the event (writing, copying, creation, etc.) cannot be earlier than this date</rdfs:comment>
        <rdfs:label xml:lang="en">not before</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#principalSubjectOrNo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#principalSubjectOrNo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Subject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">It indicates the level of subject,is primary or secondary or nothing specified or no information provided</rdfs:comment>
        <rdfs:label xml:lang="en">principal subject or no</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#startWith -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#startWith">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Person"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#PersonSubject"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">It indicates how the name is formulated (input element) (starts with first name, last name or family name)</rdfs:comment>
        <rdfs:label xml:lang="en">start with</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#whenChanged -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#whenChanged">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#RevisionDesc"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">it is the date or the date and time of the change</rdfs:comment>
        <rdfs:label xml:lang="en">when changed</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#whoChanged -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#whoChanged">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#RevisionDesc"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">indicates the person or group of people who changed the record</rdfs:comment>
        <rdfs:label xml:lang="en">who changed</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#AccessRestriction -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#AccessRestriction">
        <rdfs:comment xml:lang="en">It  indicates if the described archival unit is subject to access restrictions (consultation conditions imposed by rights holders or by the holding institution in accordance with contractual, regulatory, or legal obligations).</rdfs:comment>
        <rdfs:label xml:lang="en">access restriction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Address -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Address">
        <rdfs:comment xml:lang="en">it is used for information concerning the address,for example the address of the holding institution.</rdfs:comment>
        <rdfs:label xml:lang="en">Address</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#ArchRef -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#ArchRef">
        <rdfs:comment xml:lang="en">Reference to other archival documents</rdfs:comment>
        <rdfs:label xml:lang="en">archival reference</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Author -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Author">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Person"/>
        <rdfs:comment xml:lang="en">it is the author of the content of the manuscript or the catalogue</rdfs:comment>
        <rdfs:label xml:lang="en">author</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#BibRef -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#BibRef">
        <rdfs:comment xml:lang="en">it is a bibliography reference contained in a bibliography</rdfs:comment>
        <rdfs:label xml:lang="en">bibliographic reference</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Bibliography -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Bibliography">
        <rdfs:comment xml:lang="en">provides the bibliographic or descriptive reference</rdfs:comment>
        <rdfs:label xml:lang="en">bibliography</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Binding -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Binding">
        <rdfs:comment xml:lang="en">it describes the current and former bindings of a manuscript</rdfs:comment>
        <rdfs:label xml:lang="en">binding</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Catalogue -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Catalogue">
        <rdfs:comment xml:lang="en">It is a finding aid that describes a collection of manuscripts and facilitates access to it for consultation or use by researchers and users.It contains bibliographic records</rdfs:comment>
        <rdfs:label xml:lang="en">Catalogue</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#CatalogueIdentifier -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#CatalogueIdentifier">
        <rdfs:comment xml:lang="en">It contains essential information for unique identification and computerized catalogue management</rdfs:comment>
        <rdfs:label xml:lang="en">Catalogue Identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#City -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#City">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Place"/>
        <rdfs:comment xml:lang="en">the city where the manuscript is conserved</rdfs:comment>
        <rdfs:label xml:lang="en">city</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#CodicologicalInfo -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#CodicologicalInfo">
        <rdfs:comment xml:lang="en">it describes the composition of a codex, in particular the number and organization of the quires, specifying where applicable the presence of signatures, catchwords, old foliations, binding, etc.</rdfs:comment>
        <rdfs:label xml:lang="en">Codicological Information</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Collection -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Collection">
        <rdfs:comment xml:lang="en">It is a container that contains manuscripts</rdfs:comment>
        <rdfs:label xml:lang="en">Collection</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Contributor -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Contributor">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Institution"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Person"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A contributor is any person,family or institution, that participates in the creation or production of a resource without being its primary author, for example a co-author who writes part of the text, a translator who makes the work accessible in another language, a scholarly editor who adds notes or an introduction, an illustrator who creates images for the work, a writer who contributes specific sections, or a scribe who copies a manuscript.</rdfs:comment>
        <rdfs:label xml:lang="en">contributor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#CorporateSubject -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#CorporateSubject">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Institution"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Subject"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">It is used when the subject of the manuscript is a collectivity or institution</rdfs:comment>
        <rdfs:label xml:lang="en">corporate subject</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Country -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Country">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Place"/>
        <rdfs:comment xml:lang="en">contains the name of a geo-political unit, such as a nation, country, colony, or common wealth, larger than or administratively superior to a region and smaller than a bloc where the manuscript is conserved</rdfs:comment>
        <rdfs:label xml:lang="en">country</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Date -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Date">
        <rdfs:comment xml:lang="en">it is used for the creation date of an archival unit (the collection or the manuscript)</rdfs:comment>
        <rdfs:label xml:lang="en">Date</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Decoration -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Decoration">
        <rdfs:comment xml:lang="en">contains the description of the manuscript&apos;s decoration</rdfs:comment>
        <rdfs:label xml:lang="en">decoration</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#DigitizedVersion -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#DigitizedVersion">
        <rdfs:comment xml:lang="en">for the Digitized Version of the manuscript</rdfs:comment>
        <rdfs:label xml:lang="en">Digitized Version</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Dimensions -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Dimensions">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Institution"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Person"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">it is for the dimensions of the manuscript. Dimensions of the object/item as it is catalogued and used (often after folding, binding, etc.).</rdfs:comment>
        <rdfs:label xml:lang="en">dimensions</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Distributor -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Distributor">
        <rdfs:comment xml:lang="en">it is the distributor of the record</rdfs:comment>
        <rdfs:label xml:lang="en">distributor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#EncodingDesc -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#EncodingDesc">
        <rdfs:comment xml:lang="en">How was the encoding done and according to which choices / conventions / systems, i.e. how was the file encoded (methods, standards, vocabularies).</rdfs:comment>
        <rdfs:label xml:lang="en">encoding description</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Explicit -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Explicit">
        <rdfs:comment xml:lang="en">it is the closing words or final passage of a text, marking the end of the work.</rdfs:comment>
        <rdfs:label xml:lang="en">explicit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Extent -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Extent">
        <rdfs:comment xml:lang="en">Describes the extent of a manuscript or text, in terms of the number of folios, pages, fascicles (gatherings), or volumes (complete books which may contain multiple fascicles) and units of measurement and material. It describes the approximate size of a text stored on its medium, digital or non-digital, expressed in any appropriate unit.</rdfs:comment>
        <rdfs:label xml:lang="en">extent</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Fragment -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Fragment">
        <rdfs:comment xml:lang="en">(fragment of a manuscript) contains information about a fragment of a dispersed manuscript, now preserved separately or incorporated into another manuscript. 
It is used if the document was originally part of the manuscript but has been removed, detached, scattered, or kept elsewhere. Example: Page torn out and kept elsewhere</rdfs:comment>
        <rdfs:label xml:lang="en">Fragment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#GeographicSubject -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#GeographicSubject">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Place"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Subject"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">It is used when the subject of the manuscript is a geographic name</rdfs:comment>
        <rdfs:label xml:lang="en">Geographic Subject</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#IdentificationInformation -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#IdentificationInformation">
        <rdfs:comment xml:lang="en">It is for the identifier of the archival unit.
it supplies any form of identifier used to identify some object, such as a bibliographic item, a person, a title, an organization, etc. in a standardized way.</rdfs:comment>
        <rdfs:label xml:lang="en">identification information</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Image -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Image">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#DigitizedVersion"/>
        <rdfs:comment xml:lang="en">the digitized version of the manuscript may be an image. It contains a representation of any written source in the form of a set of images rather than in the form of a transcribed or encoded text.</rdfs:comment>
        <rdfs:label xml:lang="en">image</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Incipit -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Incipit">
        <rdfs:comment xml:lang="en">it is the opening words or initial passage of a text, used to identify or introduce the work</rdfs:comment>
        <rdfs:label xml:lang="en">incipit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Institution -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Institution">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Person"/>
        <rdfs:comment xml:lang="en">it is for the institution or organization responsible for the described archival units.</rdfs:comment>
        <rdfs:label xml:lang="en">Institution</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#LangUsage -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#LangUsage">
        <rdfs:comment xml:lang="en">It is used to indicate the language or languages in which the finding aid (catalogue) was written. it can contain text</rdfs:comment>
        <rdfs:label xml:lang="en">Lang Usage</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Language -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Language">
        <rdfs:comment xml:lang="en">It serves to indicate the language or languages ​​in which the manuscript (or its work contents) itself is written (the textual content, the works, the treatises, etc.).</rdfs:comment>
        <rdfs:comment xml:lang="en">language is used to encode a language and, if applicable, the associated writing system.</rdfs:comment>
        <rdfs:label xml:lang="en">Language</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Layout -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Layout">
        <rdfs:comment xml:lang="en">it gathers descriptions of the layouts of a manuscript. It describes how the text is laid out on the page, which includes information on any ruling systems, stitching, or other page preparation techniques.</rdfs:comment>
        <rdfs:label xml:lang="en">layout</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#LegalStatus -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#LegalStatus">
        <rdfs:comment xml:lang="en">The access restriction element must include the LegalStatus element to specify the owner and the heritage status of the document.</rdfs:comment>
        <rdfs:label xml:lang="en">legal status</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript">
        <rdfs:comment xml:lang="en">it is the ressource to be described in a record</rdfs:comment>
        <rdfs:label xml:lang="en">Manuscript</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#MsItem -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#MsItem">
        <rdfs:comment xml:lang="en">describes an individual work (text) or item within the intellectual content of a manuscript or manuscript part..</rdfs:comment>
        <rdfs:label xml:lang="en">manuscript item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Person -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Person">
        <rdfs:comment xml:lang="en">A Person is an individual human agent who contributes to the creation, production, or realization of a work, such as an author, scribe, editor, or producer.</rdfs:comment>
        <rdfs:label xml:lang="en">person</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#PersonSubject -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#PersonSubject">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Person"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Subject"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">It is used when the subject of the document is a person</rdfs:comment>
        <rdfs:label xml:lang="en">person subject</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Place -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Place">
        <rdfs:comment xml:lang="en">contains any form of place name, used to identify the place of origin for a manuscript, manuscript part, or other object. is used to identify a place (city, region, country, etc.).</rdfs:comment>
        <rdfs:label xml:lang="en">place</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Producer -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Producer">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Institution"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Person"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">It designates the producer in the archival sense, that is, the person or organization that created or assembled a fonds or a collection.</rdfs:comment>
        <rdfs:label xml:lang="en">producer</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#PublicationInfo -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#PublicationInfo">
        <rdfs:comment xml:lang="en">Information about the publictation of the resource, including place of publication, publisher, and dates associated with the resource.</rdfs:comment>
        <rdfs:label xml:lang="en">publiaction informations</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Publisher -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Publisher">
        <rdfs:comment xml:lang="en">it is the publisher of the record</rdfs:comment>
        <rdfs:label xml:lang="en">publisher</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Quire -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Quire">
        <rdfs:comment xml:lang="en">It is for the collation, which is used to describe the physical organization of a manuscript’s leaves by specifying the number of gatherings, their size, their structure (bifolia, lacunae, additions, irregularities), as well as any quire signatures</rdfs:comment>
        <rdfs:label xml:lang="en">Quire</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Record -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Record">
        <rdfs:comment xml:lang="en">It is a standardized cataloguing description that represents a manuscript as a unique physical and intellectual object, documenting its content, physical characteristics, provenance, and location in order to enable identification, management, and access.</rdfs:comment>
        <rdfs:label xml:lang="en">Record</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#RelatedMaterial -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#RelatedMaterial">
        <rdfs:comment xml:lang="en">Related documents without physical separation: These are documents that have an intellectual or contextual link, but which have never been part of the same physical set. That is to say, for all documents that are intellectually or historically linked, but never physically united. Example: Another copy of the same text kept in a different library.</rdfs:comment>
        <rdfs:label xml:lang="en">Related Material</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#RevisionDesc -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#RevisionDesc">
        <rdfs:comment xml:lang="en">This is for information on changes or modifications made to the finding aid (catalogue, record).</rdfs:comment>
        <rdfs:label xml:lang="en">revision description</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Scribe -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Scribe">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Person"/>
        <rdfs:comment xml:lang="en">This is the person who copied a manuscript, that is, who wrote the text onto the material (parchment, paper, etc.). He may also add annotations, corrections, or decorations. He is also called  copyist</rdfs:comment>
        <rdfs:label xml:lang="en">scribe</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Subject -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Subject">
        <rdfs:comment xml:lang="en">A term or phrase representing the primary topic(s) on which a work is focused. It can be controlled or uncontrolled</rdfs:comment>
        <rdfs:label xml:lang="en">subject</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Support -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Support">
        <rdfs:comment xml:lang="en">It describes the physical writing support of the manuscript’s text, for example: parchment, paper, papyrus, etc.</rdfs:comment>
        <rdfs:label xml:lang="en">support</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Taxonomy -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Taxonomy">
        <rdfs:comment xml:lang="en">contains one or more taxonomies defining the classification codes used anywhere in the text. A taxonomy is a structured system of categories that allows information to be classified and organized, indicating the system according to which the subjects, themes, or concepts of the document are classified; for example, LCSH taxonomy.</rdfs:comment>
        <rdfs:label xml:lang="en">taxonomy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#TemporalSubject -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#TemporalSubject">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Subject"/>
        <rdfs:comment xml:lang="en">It is used when the subject of the manuscript is a chronological term</rdfs:comment>
        <rdfs:label xml:lang="en">Temporal Subject</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#UniformTitleSubject -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#UniformTitleSubject">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Subject"/>
        <rdfs:comment xml:lang="en">it is used when the subject of the manuscript is a recognized and standardized work title</rdfs:comment>
        <rdfs:label xml:lang="en">Uniform Title Subject</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Volume -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Volume">
        <rdfs:comment xml:lang="en">A physical subdivision of a manuscript representing one material unit within the whole manuscript. A manuscript may consist of one or more volumes, each of which may contain one or more textual or intellectual components.</rdfs:comment>
        <rdfs:label xml:lang="en">Volume</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#WrittingStyle -->

    <owl:Class rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#WrittingStyle">
        <rdfs:comment xml:lang="en">describes the writing style used for the manuscript</rdfs:comment>
        <rdfs:label xml:lang="en">Writting Style</rdfs:label>
    </owl:Class>
    


