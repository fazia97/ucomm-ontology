        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Institution"/>
        <rdfs:comment xml:lang="en">The institution or repository that holds the manuscript or where it is available.</rdfs:comment>
        <rdfs:label xml:lang="en">is Conserved In Institution</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isContainedInCatalogue -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isContainedInCatalogue">
