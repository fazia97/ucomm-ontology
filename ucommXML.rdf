        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Layout"/>
        <rdfs:comment xml:lang="en">codicological information includes information about  the layout</rdfs:comment>
        <rdfs:label xml:lang="en">has layout</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLegalStatus -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLegalStatus">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#AccessRestriction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#LegalStatus"/>
        <rdfs:comment xml:lang="en">an access restriction of a manuscript has a leagal status</rdfs:comment>
        <rdfs:label xml:lang="en">has leagal status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasManusVolume -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasManusVolume">
