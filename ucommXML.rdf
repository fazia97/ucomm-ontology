        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript"/>
        <rdfs:comment xml:lang="en">(manuscript part) contains information about an originally distinct manuscript or part of a manuscript, which is now part of a composite manuscript</rdfs:comment>
        <rdfs:label xml:lang="en">has part</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasProducer -->

