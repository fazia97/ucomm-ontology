        <rdfs:comment xml:lang="en">the codicological description includes support of the manuscript</rdfs:comment>
        <rdfs:label xml:lang="en">has support</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasTaxonomy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasTaxonomy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#EncodingDesc"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Taxonomy"/>
        <rdfs:comment xml:lang="en">the encoding description of a manuscript has taxonomy</rdfs:comment>
        <rdfs:label xml:lang="en">has taxonomy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasWrittingStyle -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasWrittingStyle">
