        <rdfs:range rdf:resource="http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Fragment"/>
        <rdfs:comment xml:lang="en">a manuscript has a fragment</rdfs:comment>
        <rdfs:label xml:lang="en">has fragment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasIdentificationInfo -->

