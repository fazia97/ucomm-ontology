@prefix : <http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#> .

<http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm> rdf:type owl:Ontology ;
                                                                    <http://purl.org/dc/elements/1.1/creator> "Fazia BRINIS (ORCID: https://orcid.org/0009-0003-2835-4054)" ;
                                                                    <http://purl.org/dc/elements/1.1/description> """Ancient Arabic manuscripts represent a valuable cultural heritage for humanity. Their digitization contributes both to their preservation and to broadening access for the international scholarly community. However, the effective exploitation of these digital resources within digital libraries remains challenged by several major issues. On the one hand, the heterogeneity of the encoding formats of the catalogues, resulting from the use of various standards such as EAD (Encoded Archival Description), TEI (Text Encoding Initiative), MARCXML (Machine Readable Cataloguing), MODS (Metadata Object Description Schema), or DC (Dublin Core) by heritage institutions, complicates cross-catalogue searching. On the other hand, these standards often have gaps or missing information for certain metadata, as the corresponding values are not systematically provided or are poorly represented, which limits semantic exploitation and search quality \\r.

Furthermore, existing cataloguing standards are generally designed for specific types of manuscripts, leading to the marginalization of certain manuscript traditions, particularly Arabic manuscripts, which do not currently have a universally adopted cataloguing standard. All of these factors hinder global, integrated and optimal access to digitized collections. To address these issues, this article proposes a semantic approach guided by an ontology called UCOMM (Unified Cataloguing Ontology Model for Manuscripts), which aims to ensure interoperability between the metadata encoding formats of digitized ancient manuscripts \\r. 

This approach introduces a unified conceptual model, developed from the common concepts of existing standards and formalized using semantic web technologies, notably RDF (Resource Description Framework) and OWL (Web Ontology Language), in order to facilitate the integration, enrichment, and unified querying of heterogeneous catalogues \\r. 

By aligning manuscript metadata with Linked Data principles, the proposed model contributes to improving the compliance of these metadata with the FAIR principles, thereby enhancing their findability, accessibility, interoperability, and reusability within digital library infrastructures."""@en ;
                                                                    <http://purl.org/dc/elements/1.1/rights> "This work is distributed under a Creative Commons Attribution 4.0 International License (CC BY 4.0) (https://creativecommons.org/licenses/by/4.0/)"@en ;
                                                                    rdfs:comment "UCOMM (Unified Cataloguing Ontology Model for Manuscripts) is an Ontological model for the Heterogeneous Manuscript Resources"@en ;
                                                                    rdfs:label "Unified Cataloguing Ontology Model for Manuscripts"@en ;
                                                                    owl:versionInfo "version 1-1-2026"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/creator
<http://purl.org/dc/elements/1.1/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
<http://purl.org/dc/elements/1.1/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/rights
<http://purl.org/dc/elements/1.1/rights> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#conservesCollection
:conservesCollection rdf:type owl:ObjectProperty ;
                     owl:inverseOf :hasConservationInstitution ;
                     rdfs:domain :Institution ;
                     rdfs:range :Collection ;
                     rdfs:comment "an institution conserves a collection of manuscripts"@en ;
                     rdfs:label "conserves collection"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#containsCity
:containsCity rdf:type owl:ObjectProperty ;
              rdfs:domain :Country ;
              rdfs:range :City ;
              rdfs:comment "a country contains one or more cities"@en ;
              rdfs:label "contains city"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#containsManuscript
:containsManuscript rdf:type owl:ObjectProperty ;
                    owl:inverseOf :isContainedInCollection ;
                    rdfs:domain :Collection ;
                    rdfs:range :Manuscript ;
                    rdfs:comment "a collection has one or more manuscripts"@en ;
                    rdfs:label "contains manuscript"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#containsRecord
:containsRecord rdf:type owl:ObjectProperty ;
                owl:inverseOf :isContainedInCatalogue ;
                rdfs:domain :Catalogue ;
                rdfs:range :Record ;
                rdfs:comment "a catalogue contains one or more manuscript records"@en ;
                rdfs:label "contains record"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#copied
:copied rdf:type owl:ObjectProperty ;
        owl:inverseOf :isCopiedBy ;
        rdfs:domain :Scribe ;
        rdfs:range :Manuscript ;
        rdfs:comment "a scribe copied a manuscript"@en ;
        rdfs:label "copied"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#describesCollection
:describesCollection rdf:type owl:ObjectProperty ;
                     owl:inverseOf :isDescribedByCatalogue ;
                     rdfs:domain :Catalogue ;
                     rdfs:range :Collection ;
                     rdfs:comment "the finding aid (catalogue) describes a collection of manuscripts"@en ;
                     rdfs:label "describes collection"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#describesManuscript
:describesManuscript rdf:type owl:ObjectProperty ;
                     owl:inverseOf :isDescribedByRecord ;
                     rdfs:domain :Record ;
                     rdfs:range :Manuscript ;
                     rdfs:comment "a record describes a manuscript"@en ;
                     rdfs:label "describes manuscript"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#describesVolume
:describesVolume rdf:type owl:ObjectProperty ;
                 owl:inverseOf :isDescribedBy ;
                 rdfs:comment "a record describes a volume of a manuscript in the case of volume cataloguing"@en ;
                 rdfs:label "describes volume"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAccessRestriction
:hasAccessRestriction rdf:type owl:ObjectProperty ;
                      rdfs:domain [ rdf:type owl:Class ;
                                    owl:unionOf ( :Collection
                                                  :Manuscript
                                                )
                                  ] ;
                      rdfs:range :AccessRestriction ;
                      rdfs:comment "a collection or a manuscript has access restriction" ;
                      rdfs:label "has access restriction"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAddress
:hasAddress rdf:type owl:ObjectProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :Distributor
                                        :Institution
                                        :Publisher
                                      )
                        ] ;
            rdfs:range :Address ;
            rdfs:comment "it is the address of an institution"@en ;
            rdfs:label "has address"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAlternativeIdentifier
:hasAlternativeIdentifier rdf:type owl:ObjectProperty ;
                          rdfs:domain :Manuscript ;
                          rdfs:range :IdentificationInformation ;
                          rdfs:comment "(alternative identifier) contains an alternative or former structured identifier used for a manuscript, such as a former catalogue number. "@en ;
                          rdfs:label "has Alternative Identifier"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasArchRef
:hasArchRef rdf:type owl:ObjectProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :Fragment
                                        :RelatedMaterial
                                      )
                        ] ;
            rdfs:range :ArchRef ;
            rdfs:comment "a fragment or a related material of a manuscript may contain other archival documents"@en ;
            rdfs:label "has archival reference"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAuthor
:hasAuthor rdf:type owl:ObjectProperty ;
           owl:inverseOf :isAuthorOf ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :Catalogue
                                       :Manuscript
                                       :MsItem
                                     )
                       ] ;
           rdfs:range :Author ;
           rdfs:comment "a catalogue or a manuscript or a manuscript work has an author"@en ;
           rdfs:label "has author"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasBibRef
:hasBibRef rdf:type owl:ObjectProperty ;
           rdfs:domain :Bibliography ;
           rdfs:range :BibRef ;
           rdfs:comment "a bibliography contains one or more bibligraphic references"@en ;
           rdfs:label "has bibliographic reference"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasBibliography
:hasBibliography rdf:type owl:ObjectProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( :Manuscript
                                             :Taxonomy
                                           )
                             ] ;
                 rdfs:range :Bibliography ;
                 rdfs:comment "a manuscript or a taxonomy has a bibliography"@en ;
                 rdfs:label "has Bibliography"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasBinding
:hasBinding rdf:type owl:ObjectProperty ;
            rdfs:domain :CodicologicalInfo ;
            rdfs:range :Binding ;
            rdfs:comment "codicological information include binding"@en ;
            rdfs:label "has binding"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasChangeDate
:hasChangeDate rdf:type owl:ObjectProperty ;
               rdfs:domain :RevisionDesc ;
               rdfs:range :Date ;
               rdfs:comment "it is the date of the change"@en ;
               rdfs:label "has change date"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCodicologicalInfo
:hasCodicologicalInfo rdf:type owl:ObjectProperty ;
                      rdfs:domain :Manuscript ;
                      rdfs:range :CodicologicalInfo ;
                      rdfs:comment "it contains the description of the physical components of the manuscript"@en ;
                      rdfs:label "has Codicological Information"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasConservationInstitution
:hasConservationInstitution rdf:type owl:ObjectProperty ;
                            rdfs:domain :Collection ;
                            rdfs:range :Institution ;
                            rdfs:comment "a collection is conserved in an institution"@en ;
                            rdfs:label "has conservation institution"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasContentItem
:hasContentItem rdf:type owl:ObjectProperty ;
                rdfs:domain :Manuscript ;
                rdfs:range :MsItem ;
                rdfs:comment "it is for each content item(text) contained in a manuscript"@en ;
                rdfs:label "has Content Item"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasContributor
:hasContributor rdf:type owl:ObjectProperty ;
                owl:inverseOf :isContributorOf ;
                rdfs:domain :Manuscript ;
                rdfs:range :Contributor ;
                rdfs:comment "a manuscript has a contributor e.g. illustrator, traductor,.."@en ;
                rdfs:label "has contributor"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCreationDate
:hasCreationDate rdf:type owl:ObjectProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( :Collection
                                             :Manuscript
                                           )
                             ] ;
                 rdfs:range :Date ;
                 rdfs:comment "it is for the creation date of a collection or a manuscript"@en ;
                 rdfs:label "has creation Date"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCreationPlace
:hasCreationPlace rdf:type owl:ObjectProperty ;
                  rdfs:domain :Manuscript ;
                  rdfs:range :Place ;
                  rdfs:comment "a manuscript is created or copied in a palce"@en ;
                  rdfs:label "has Creation Place"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDecoration
:hasDecoration rdf:type owl:ObjectProperty ;
               rdfs:domain :Manuscript ;
               rdfs:range :Decoration ;
               rdfs:comment "a manuscript may have decorations"@en ;
               rdfs:label "has decoration"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDigitizedVersion
:hasDigitizedVersion rdf:type owl:ObjectProperty ;
                     rdfs:domain :Manuscript ;
                     rdfs:range :DigitizedVersion ;
                     rdfs:comment "to establish a link to one or more digital representations of the described manuscripts"@en ;
                     rdfs:label "has digitized version"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDimensions
:hasDimensions rdf:type owl:ObjectProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( :CodicologicalInfo
                                           :Extent
                                         )
                           ] ;
               rdfs:range :Dimensions ;
               rdfs:comment "the codicological information of manuscript includes the dimensions of the manuscript or the extent includes the dimensions"@en ;
               rdfs:label "has dimensions"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasEncodingDesc
:hasEncodingDesc rdf:type owl:ObjectProperty ;
                 rdfs:domain :Record ;
                 rdfs:range :EncodingDesc ;
                 rdfs:comment "a manuscript record has encoding description"@en ;
                 rdfs:label "has encoding description"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasExplicit
:hasExplicit rdf:type owl:ObjectProperty ;
             rdfs:domain :MsItem ;
             rdfs:range :Explicit ;
             rdfs:comment "a work has an explicit"@en ;
             rdfs:label "has explicit"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasExtent
:hasExtent rdf:type owl:ObjectProperty ;
           rdfs:domain :CodicologicalInfo ;
           rdfs:range :Extent ;
           rdfs:comment "the codicological description includes extent of the manuscript"@en ;
           rdfs:label "has extent"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasFrag
:hasFrag rdf:type owl:ObjectProperty ;
         rdfs:domain :Manuscript ;
         rdfs:range :Fragment ;
         rdfs:comment "a manuscript has a fragment"@en ;
         rdfs:label "has fragment"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasIdentificationInfo
:hasIdentificationInfo rdf:type owl:ObjectProperty ;
                       rdfs:domain [ rdf:type owl:Class ;
                                     owl:unionOf ( :Collection
                                                   :Manuscript
                                                 )
                                   ] ;
                       rdfs:range :IdentificationInformation ;
                       rdfs:comment "it is for identification information of a collection or a manuscript"@en ;
                       rdfs:label "has identification informations"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasIdentifierInfo
:hasIdentifierInfo rdf:type owl:ObjectProperty ;
                   rdfs:domain :Catalogue ;
                   rdfs:range :CatalogueIdentifier ;
                   rdfs:comment "The value of the identifier attribute must consist of a unique international identifier, either generated by the system (such as an ARK), or entered according to the following structure: FR, followed, where applicable, by the collective catalog identifier and the RCR number of the institution responsible for intellectual access according to the order defined by the collective catalogue, and finally a unique identifier."@en ;
                   rdfs:label "has identifier information"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasIncipit
:hasIncipit rdf:type owl:ObjectProperty ;
            rdfs:domain :MsItem ;
            rdfs:range :Incipit ;
            rdfs:comment "a work has an incipit"@en ;
            rdfs:label "has incipit"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLangMaterial
:hasLangMaterial rdf:type owl:ObjectProperty ;
                 rdfs:domain :Manuscript ;
                 rdfs:range :Language ;
                 rdfs:comment "the language in which the manuscript is written with"@en ;
                 rdfs:label "has lang material"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLangUsage
:hasLangUsage rdf:type owl:ObjectProperty ;
              rdfs:domain :Catalogue ;
              rdfs:range :LangUsage ;
              rdfs:comment "It is used to indicate the language or languages in which the finding aid was written."@en ;
              rdfs:label "has language usage"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLanguage
:hasLanguage rdf:type owl:ObjectProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :MsItem
                                         :Record
                                       )
                         ] ;
             rdfs:range :Language ;
             rdfs:comment "a record or a manuscript item is written in a language e.G. french, english,..."@en ;
             rdfs:label "ha language"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLayout
:hasLayout rdf:type owl:ObjectProperty ;
           rdfs:domain :CodicologicalInfo ;
           rdfs:range :Layout ;
           rdfs:comment "codicological information includes information about  the layout"@en ;
           rdfs:label "has layout"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLegalStatus
:hasLegalStatus rdf:type owl:ObjectProperty ;
                rdfs:domain :AccessRestriction ;
                rdfs:range :LegalStatus ;
                rdfs:comment "an access restriction of a manuscript has a leagal status"@en ;
                rdfs:label "has leagal status"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasManusVolume
:hasManusVolume rdf:type owl:ObjectProperty ;
                owl:inverseOf :isVolumeOf ;
                rdfs:domain :Manuscript ;
                rdfs:range :Volume ;
                rdfs:comment "Relates a manuscript to one or more physical volumes that constitute its material structure."@en ;
                rdfs:label "has volume"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasPart
:hasPart rdf:type owl:ObjectProperty ;
         rdfs:domain :Manuscript ;
         rdfs:range :Manuscript ;
         rdfs:comment "(manuscript part) contains information about an originally distinct manuscript or part of a manuscript, which is now part of a composite manuscript"@en ;
         rdfs:label "has part"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasProducer
:hasProducer rdf:type owl:ObjectProperty ;
             rdfs:domain :Collection ;
             rdfs:range :Producer ;
             rdfs:comment "the producer of the manuscript collection"@en ;
             rdfs:label "has producer"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasPublicationInfo
:hasPublicationInfo rdf:type owl:ObjectProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( :Catalogue
                                                :Record
                                              )
                                ] ;
                    rdfs:range :PublicationInfo ;
                    rdfs:comment "a record or a catalogue has a publication information"@en ;
                    rdfs:label "has publication information"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasQuire
:hasQuire rdf:type owl:ObjectProperty ;
          rdfs:domain :CodicologicalInfo ;
          rdfs:range :Quire ;
          rdfs:comment "codicological information includes information about  a quire"@en ;
          rdfs:label "has Quire"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRecordCreator
:hasRecordCreator rdf:type owl:ObjectProperty ;
                  rdfs:domain :Record ;
                  rdfs:range :Producer ;
                  rdfs:comment "a record has a creator"@en ;
                  rdfs:label "has record creator"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRelatedMaterial
:hasRelatedMaterial rdf:type owl:ObjectProperty ;
                    rdfs:domain :Manuscript ;
                    rdfs:range :RelatedMaterial ;
                    rdfs:comment "a manuscript has a related material"@en ;
                    rdfs:label "has Related Material"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRevisionDesc
:hasRevisionDesc rdf:type owl:ObjectProperty ;
                 rdfs:domain :Catalogue ;
                 rdfs:range :RevisionDesc ;
                 rdfs:comment "a catalogue has revision description"@en ;
                 rdfs:label "has revision description"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasScribe
:hasScribe rdf:type owl:ObjectProperty ;
           rdfs:domain :WrittingStyle ;
           rdfs:range :Scribe ;
           rdfs:comment "writting style or manuscript has a scribe (copyist)"@en ;
           rdfs:label "has scribe"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasSubject
:hasSubject rdf:type owl:ObjectProperty ;
            owl:inverseOf :isSubjectOf ;
            rdfs:domain :Manuscript ;
            rdfs:range :Subject ;
            rdfs:comment "a manuscript has a subject"@en ;
            rdfs:label "has subject"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasSupport
:hasSupport rdf:type owl:ObjectProperty ;
            rdfs:domain :CodicologicalInfo ;
            rdfs:range :Support ;
            rdfs:comment "the codicological description includes support of the manuscript"@en ;
            rdfs:label "has support"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasTaxonomy
:hasTaxonomy rdf:type owl:ObjectProperty ;
             rdfs:domain :EncodingDesc ;
             rdfs:range :Taxonomy ;
             rdfs:comment "the encoding description of a manuscript has taxonomy"@en ;
             rdfs:label "has taxonomy"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasWrittingStyle
:hasWrittingStyle rdf:type owl:ObjectProperty ;
                  rdfs:domain :Manuscript ;
                  rdfs:range :WrittingStyle ;
                  rdfs:comment "a manuscript is written with a writting style"@en ;
                  rdfs:label "has Writting Style"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#includes
:includes rdf:type owl:ObjectProperty ;
          rdfs:domain :PublicationInfo ;
          rdfs:range [ rdf:type owl:Class ;
                       owl:unionOf ( :Date
                                     :Distributor
                                     :Publisher
                                   )
                     ] ;
          rdfs:comment "the publication information includes the publisher, the place of publication, .."@en ;
          rdfs:label "includes"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isAuthorOf
:isAuthorOf rdf:type owl:ObjectProperty ;
            rdfs:comment "an entity is author of a manuscript"@en ;
            rdfs:label "is author of"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isConservatingInstitutionOf
:isConservatingInstitutionOf rdf:type owl:ObjectProperty ;
                             owl:inverseOf :isConservedInInstitution ;
                             rdfs:comment "it is the conservating institution where a manuscript is conserved"@en ;
                             rdfs:label "is the conservating institution of"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isConservedInCity
:isConservedInCity rdf:type owl:ObjectProperty ;
                   rdfs:domain :Manuscript ;
                   rdfs:range :City ;
                   rdfs:comment "the city where the manuscript is conserved"@en ;
                   rdfs:label "is Conserved In City"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isConservedInInstitution
:isConservedInInstitution rdf:type owl:ObjectProperty ;
                          rdfs:domain :Manuscript ;
                          rdfs:range :Institution ;
                          rdfs:comment "The institution or repository that holds the manuscript or where it is available."@en ;
                          rdfs:label "is Conserved In Institution"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isContainedInCatalogue
:isContainedInCatalogue rdf:type owl:ObjectProperty ;
                        rdfs:comment "a record is contained in a catalogue"@en ;
                        rdfs:label "is contained in  catalogue"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isContainedInCollection
:isContainedInCollection rdf:type owl:ObjectProperty ;
                         rdfs:comment "a manuscript belongs to a collection"@en ;
                         rdfs:label "is contained in collection"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isContributorOf
:isContributorOf rdf:type owl:ObjectProperty ;
                 rdfs:comment "it is the contributor of the manuscript"@en ;
                 rdfs:label "is contributor of"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isCopiedBy
:isCopiedBy rdf:type owl:ObjectProperty ;
            rdfs:comment "a manuscript is copied by a scribe"@en ;
            rdfs:label "is copied by"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isDescribedBy
:isDescribedBy rdf:type owl:ObjectProperty ;
               rdfs:domain :Volume ;
               rdfs:range :Record ;
               rdfs:comment "Relates a volume to a catalogue or descriptive record that provides metadata about it."@en ;
               rdfs:label "is described by"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isDescribedByCatalogue
:isDescribedByCatalogue rdf:type owl:ObjectProperty ;
                        rdfs:comment "a collection is described by a catalogue following an encoding standard"@en ;
                        rdfs:label "is described by a catalogue"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isDescribedByRecord
:isDescribedByRecord rdf:type owl:ObjectProperty ;
                     rdfs:comment "a manuscript is described by a record"@en ;
                     rdfs:label "is described by record"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isSubjectOf
:isSubjectOf rdf:type owl:ObjectProperty ;
             rdfs:comment "a subject is a subject of a manuscript"@en ;
             rdfs:label "is subject of"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isVolumeOf
:isVolumeOf rdf:type owl:ObjectProperty ;
            rdfs:comment "a volume is a volume of a manuscript"@en ;
            rdfs:label "is volume of"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#usesLanguage
:usesLanguage rdf:type owl:ObjectProperty ;
              rdfs:domain :LangUsage ;
              rdfs:range :Language ;
              rdfs:comment "a lang usage uses a  language"@en ;
              rdfs:label "uses language"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#HowShelved
:HowShelved rdf:type owl:DatatypeProperty ;
            rdfs:domain :Institution ;
            rdfs:range xsd:string ;
            rdfs:comment "refers to the system used to shelve a bibliographic item in the collections of the reporting organization for example shelved by title."@en ;
            rdfs:label "how shelved"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAbstract
:hasAbstract rdf:type owl:DatatypeProperty ;
             rdfs:domain :Manuscript ;
             rdfs:range xsd:string ;
             rdfs:comment "contains the text of the abstract or summary, the analytical summary, or an expanded version of the abstract"@en ;
             rdfs:label "has Abstract"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAccMat
:hasAccMat rdf:type owl:DatatypeProperty ;
           rdfs:domain :CodicologicalInfo ;
           rdfs:range xsd:string ;
           rdfs:comment "(accompanying material) gives details of any accompanying material closely associated with the manuscript, such as non-contemporary documents or fragments related to the manuscript at an earlier time (Related but not original material)."@en ;
           rdfs:label "has accompanying material"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAccessMethod
:hasAccessMethod rdf:type owl:DatatypeProperty ;
                 rdfs:domain :DigitizedVersion ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Access method to the electronic resource.The methods defined are the main TCP/IP (Transmission Control Protocol/Internet Protocol) protocols."@en ;
                 rdfs:label "has Access Method"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAccruals
:hasAccruals rdf:type owl:DatatypeProperty ;
             rdfs:domain :Manuscript ;
             rdfs:range xsd:string ;
             rdfs:comment "This is for information regarding planned enhancements to the manuscript."@en ;
             rdfs:label "has Accruals"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAcqInfo
:hasAcqInfo rdf:type owl:DatatypeProperty ;
            rdfs:domain :Manuscript ;
            rdfs:range xsd:string ;
            rdfs:comment "This concerns information relating to how documentary units entered the preservation institution. That is to say, how the manuscript was acquired by the institution, for example, through a donation, purchase, bequest, deposit, administrative transfer, date of entry, previous owner, administrative provenance, etc."@en ;
            rdfs:label "has Acquisition Information"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAddressLine
:hasAddressLine rdf:type owl:DatatypeProperty ;
                rdfs:domain :Address ;
                rdfs:range xsd:string ;
                rdfs:comment "each address  contains one or more postal address line."@en ;
                rdfs:label "has address Line"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAffiliation
:hasAffiliation rdf:type owl:DatatypeProperty ;
                rdfs:domain :Person ;
                rdfs:range xsd:string ;
                rdfs:comment "The name of an organization, institution, etc. with which the entity was associated at the time that the resource was created."@en ;
                rdfs:label "has affiliation"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAlphabet
:hasAlphabet rdf:type owl:DatatypeProperty ;
             rdfs:domain :Language ;
             rdfs:range xsd:string ;
             rdfs:comment "Specifies the alphabet, script, or notation system that is used in the resource. This includes specialized scripts, typefaces, or codes (e.g., Arabic alphabet, Arabic numerals, ASCII, bar code, BCD, braille, ciphers, Cyrillic alphabet, EBCDIC, Fraktur, Greek alphabet, Hebrew alphabet, hieroglyphics, pictograms, Roman alphabet, Roman numerals, or logarithmic or semilogarithmic graphing, etc.)."@en ;
             rdfs:label "has Alphabet"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAlternativeForm
:hasAlternativeForm rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Manuscript ;
                    rdfs:range xsd:string ;
                    rdfs:comment "It serves to indicate that there are other forms, versions or media of the same document, for example: a digitization of the manuscript, a microfilm copy, a printed edition, a transcription, a translation, a photographic reproduction."@en ;
                    rdfs:label "has Alternative Form"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAlternativeName
:hasAlternativeName rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Manuscript ;
                    rdfs:range xsd:string ;
                    rdfs:comment "it is an alternative title which is a varying form of the title"@en ;
                    rdfs:label "has Alternative Name"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAngleAlef
:hasAngleAlef rdf:type owl:DatatypeProperty ;
              rdfs:domain :WrittingStyle ;
              rdfs:range xsd:float ;
              rdfs:comment "This is the angle of inclination of the letter alif"@en ;
              rdfs:label "has Angle Alef"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAngleKaf
:hasAngleKaf rdf:type owl:DatatypeProperty ;
             rdfs:domain :WrittingStyle ;
             rdfs:range xsd:float ;
             rdfs:comment "This is the angle of inclination of the letter kaf" ;
             rdfs:label "has Angle Kaf"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAppraisal
:hasAppraisal rdf:type owl:DatatypeProperty ;
              rdfs:domain :Manuscript ;
              rdfs:range xsd:string ;
              rdfs:comment "This is for information relating to any sorting and disposal carried out by the conservation institution."@en ;
              rdfs:label "has appraisal"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasArchRefValue
:hasArchRefValue rdf:type owl:DatatypeProperty ;
                 rdfs:domain :ArchRef ;
                 rdfs:range xsd:string ;
                 rdfs:comment "This is a reference to an external archival reference to other documents described online, here to separate documents"@en ;
                 rdfs:label "has archival reference"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasArrangement
:hasArrangement rdf:type owl:DatatypeProperty ;
                rdfs:domain :Manuscript ;
                rdfs:range xsd:string ;
                rdfs:comment "This is for all information about the structure, order, or classification plan of the description unit."@en ;
                rdfs:label "has arrangement"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAuthefilNumber
:hasAuthefilNumber rdf:type owl:DatatypeProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( :Institution
                                               :Person
                                               :Place
                                               :Subject
                                             )
                               ] ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Unique identifier of the institution within the authority file"@en ;
                   rdfs:label "has authfil number"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAuthority
:hasAuthority rdf:type owl:DatatypeProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :Institution
                                          :Person
                                          :Subject
                                        )
                          ] ;
              rdfs:range xsd:string ;
              rdfs:comment "it indicates the source of the controlled vocabulary used for the subject heading for example lcsh, RVM, CSH,..or  the authority file used"@en ;
              rdfs:label "has Authority"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAuthorizedUsers
:hasAuthorizedUsers rdf:type owl:DatatypeProperty ;
                    rdfs:domain :AccessRestriction ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Class of users or specific individuals (by name or title) to whom the restrictions do not apply."@en ;
                    rdfs:label "has authorized users"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasAvailabilityDate
:hasAvailabilityDate rdf:type owl:DatatypeProperty ;
                     rdfs:domain :AccessRestriction ;
                     rdfs:range xsd:date ;
                     rdfs:comment "Date when the resource changes its access status, e.g., when it becomes freely available. Preferred structure for the date is according to Date and Time (ISO 8601): yyyymmdd."@en ;
                     rdfs:label "has availability date"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasBibRefValue
:hasBibRefValue rdf:type owl:DatatypeProperty ;
                rdfs:domain :BibRef ;
                rdfs:range xsd:string ;
                rdfs:comment "it is the name of the bibliographic reference"@en ;
                rdfs:label "has bibliographic reference"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasBindingInfo
:hasBindingInfo rdf:type owl:DatatypeProperty ;
                rdfs:domain :Binding ;
                rdfs:range xsd:string ;
                rdfs:comment "it is an abstract of the binding in the form of a paragraph"@en ;
                rdfs:label "has Binding Information"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasBioghist
:hasBioghist rdf:type owl:DatatypeProperty ;
             rdfs:domain :Manuscript ;
             rdfs:range xsd:string ;
             rdfs:comment "This is for the information relating to the producer of the collections (individual, family, or community) necessary for a proper understanding of the documents described."@en ;
             rdfs:label "has bioghist"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasBoard
:hasBoard rdf:type owl:DatatypeProperty ;
          rdfs:domain :Binding ;
          rdfs:range xsd:string ;
          rdfs:comment "it is the board contained in the cover. The board = the “flat” of the book: The solid piece found at the front and back, onto which the leather or parchment that covers the binding is glued; ; it can be made of wood or cardboard."@en ;
          rdfs:label "has board"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCalendar
:hasCalendar rdf:type owl:DatatypeProperty ;
             rdfs:domain :Date ;
             rdfs:range [ rdf:type rdfs:Datatype ;
                          owl:unionOf ( xsd:NMTOKEN
                                        [ rdf:type rdfs:Datatype ;
                                          owl:oneOf [ rdf:type rdf:List ;
                                                      rdf:first "chinese" ;
                                                      rdf:rest [ rdf:type rdf:List ;
                                                                 rdf:first "gregorian" ;
                                                                 rdf:rest [ rdf:type rdf:List ;
                                                                            rdf:first "hebrew" ;
                                                                            rdf:rest [ rdf:type rdf:List ;
                                                                                       rdf:first "islamic" ;
                                                                                       rdf:rest [ rdf:type rdf:List ;
                                                                                                  rdf:first "julian" ;
                                                                                                  rdf:rest [ rdf:type rdf:List ;
                                                                                                             rdf:first "revolutionnaire" ;
                                                                                                             rdf:rest rdf:nil
                                                                                                           ]
                                                                                                ]
                                                                                     ]
                                                                          ]
                                                               ]
                                                    ]
                                        ]
                                      )
                        ] ;
             rdfs:comment "the calendar used in the date"@en ;
             rdfs:label "has calendar"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCatalogingLanguage
:hasCatalogingLanguage rdf:type owl:DatatypeProperty ;
                       rdfs:domain :Record ;
                       rdfs:range xsd:language ;
                       rdfs:comment "The language of the text of the record. it Contains the language(s) of the metadata record."@en ;
                       rdfs:label "has cataloguing language"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCatchWords
:hasCatchWords rdf:type owl:DatatypeProperty ;
               rdfs:domain :CodicologicalInfo ;
               rdfs:range xsd:string ;
               rdfs:comment "it describes the system used to ensure correct ordering of the quires or similar making up a codex, incunable, or other object typically by means of annotations at the foot of the page."@en ;
               rdfs:label "has catch words"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasChangeItem
:hasChangeItem rdf:type owl:DatatypeProperty ;
               rdfs:domain :RevisionDesc ;
               rdfs:range xsd:string ;
               rdfs:comment "it describes the nature of the changes."@en ;
               rdfs:label "has change item"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasColophon
:hasColophon rdf:type owl:DatatypeProperty ;
             rdfs:domain :MsItem ;
             rdfs:range xsd:string ;
             rdfs:comment "contains the colophon of an item: that is, a statement providing information regarding the date, place, agency, or reason for production of the manuscript"@en ;
             rdfs:label "has colophon"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasColorContent
:hasColorContent rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Support ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Color characteristics of the content of a resource. Achromatic values (white, gray, and black) are considered to be colors."@en ;
                 rdfs:label "has color content"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasColumns
:hasColumns rdf:type owl:DatatypeProperty ;
            rdfs:domain :Layout ;
            rdfs:range xsd:int ;
            rdfs:comment "specifies the number of columns present on a page"@en ;
            rdfs:label "has columns"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasConditioning
:hasConditioning rdf:type owl:DatatypeProperty ;
                 rdfs:domain :CodicologicalInfo ;
                 rdfs:range xsd:string ;
                 rdfs:comment "It is for the packaging (conditionning) carried out before the manuscript entered the conservation institution."@en ;
                 rdfs:label "has conditioning"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCorporateNameType
:hasCorporateNameType rdf:type owl:DatatypeProperty ;
                      rdfs:domain :CorporateSubject ;
                      rdfs:range xsd:string ;
                      rdfs:comment "This type of community name entry has three values: 0: Inverted name; 1: Jurisdiction name; 2: Name in direct order"@en ;
                      rdfs:label "has Corporate Name Type"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCountryCode
:hasCountryCode rdf:type owl:DatatypeProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :CatalogueIdentifier
                                            :Institution
                                          )
                            ] ;
                rdfs:range xsd:string ;
                rdfs:comment "Country code of the producing institution"@en ;
                rdfs:label "has country code"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCountryEncoding
:hasCountryEncoding rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Catalogue ;
                    rdfs:range xsd:NMTOKEN ;
                    rdfs:comment "it Indicates the country of the institution producing the file (e.g., FR for France, US for United States)"@en ;
                    rdfs:label "has country encoding"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCover
:hasCover rdf:type owl:DatatypeProperty ;
          rdfs:domain :Binding ;
          rdfs:range xsd:string ;
          rdfs:comment "a manuscript has a cover"@en ;
          rdfs:label "has Cover"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCoverage
:hasCoverage rdf:type owl:DatatypeProperty ;
             rdfs:domain :Manuscript ;
             rdfs:range xsd:string ;
             rdfs:comment "Spatiotemporal scope or coverage of the manuscript"@en ;
             rdfs:label "has Coverage"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasCreationInfo
:hasCreationInfo rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Catalogue ;
                 rdfs:range xsd:string ;
                 rdfs:comment "This is for information on the initial encoding of the finding aid; it must always specify: the format version and the possible use of a schema; the cataloging tool, in the case of ongoing cataloging; the details of any conversion (source, format, service provider, etc.) and may also mention the name of the encoder and the date of encoding."@en ;
                 rdfs:label "has creation information"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDate
:hasDate rdf:type owl:DatatypeProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :Institution
                                     :Person
                                     :PersonSubject
                                   )
                     ] ;
         rdfs:range xsd:dateTime ;
         rdfs:comment "Used to parse a date (for example a birth date) included for the purpose of distinguishing individuals with the same name."@en ;
         rdfs:label "has date"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDateCreation
:hasDateCreation rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Record ;
                 rdfs:range xsd:date ;
                 rdfs:comment "The date or date and time when the original record was first created."@en ;
                 rdfs:label "has creation date"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDateEncoding
:hasDateEncoding rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Catalogue ;
                 rdfs:range xsd:NMTOKEN ;
                 rdfs:comment "Standard format for dates (e.g., 2025-12-15 for December 15, 2025)"@en ;
                 rdfs:label "has date encoding"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDateValue
:hasDateValue rdf:type owl:DatatypeProperty ;
              rdfs:domain :Date ;
              rdfs:range xsd:dateTime ;
              rdfs:comment "it is the value of the data element"@en ;
              rdfs:label "has date value"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDecorationInfo
:hasDecorationInfo rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Decoration ;
                   rdfs:range xsd:string ;
                   rdfs:comment "It contains description informations of the decoration of a manuscript"@en ;
                   rdfs:label "has decoration information"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDecorationNote
:hasDecorationNote rdf:type owl:DatatypeProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( :Binding
                                               :Decoration
                                             )
                               ] ;
                   rdfs:range xsd:string ;
                   rdfs:comment "it is used to describe the decorative elements associated with the book binding."@en ;
                   rdfs:label "has decoration note"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDensity
:hasDensity rdf:type owl:DatatypeProperty ;
            rdfs:domain :WrittingStyle ;
            rdfs:range xsd:string ;
            rdfs:comment "The number of letters written over a given distance. That is to say, how close the writing is, and high density = very close writing."@en ;
            rdfs:label "has density"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDescription
:hasDescription rdf:type owl:DatatypeProperty ;
                rdfs:domain :DigitizedVersion ;
                rdfs:range xsd:string ;
                rdfs:comment "it is the description of the digital ressource. In mods, It indicates how the document attained its digital form; its possible values ​​are: born digital: the resource was born digital and will remain digital; reformatted digital: an original analog document was directly digitized; digitized microfilm: the file comes from the digitization of a microfilm, itself an analog copy; digitized other analog: the resource comes from the digitization of a secondary analog copy."@en ;
                rdfs:label "has description"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDescriptionRules
:hasDescriptionRules rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Record ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Designates the rules used for the content of the description, it is the code for or the title of the description rules used in creating the record. The subfield may also be used to record the use of AACR 2-based manuals."@en ;
                     rdfs:label "has description rules"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDiameter
:hasDiameter rdf:type owl:DatatypeProperty ;
             rdfs:domain :Dimensions ;
             rdfs:range xsd:string ;
             rdfs:comment "the diameter dimension"@en ;
             rdfs:label "has diameter"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDimensionsInfo
:hasDimensionsInfo rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Dimensions ;
                   rdfs:range xsd:string ;
                   rdfs:comment "the textual value of dimensions Tag (often after folding, binding, etc.)."@en ;
                   rdfs:label "has dimensions info"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasDocumentType
:hasDocumentType rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Manuscript ;
                 rdfs:range xsd:string ;
                 rdfs:comment "It is used to describe the type or form of a resource. This is for the type of resource to be described, Nature or genre of the resource content e.g. handwritten text."@en ;
                 rdfs:label "has document type"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasEmail
:hasEmail rdf:type owl:DatatypeProperty ;
          rdfs:domain :Distributor ;
          rdfs:range xsd:string ;
          rdfs:comment "it is the email of an entity"@en ;
          rdfs:label "has email"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasEncodingAnalog
:hasEncodingAnalog rdf:type owl:DatatypeProperty ;
                   rdfs:domain :CatalogueIdentifier ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Indicates the equivalence with another metadata standard (dc, marc, etc)"@en ;
                   rdfs:label "has encoding analog"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasEra
:hasEra rdf:type owl:DatatypeProperty ;
        rdfs:domain :Date ;
        rdfs:range [ rdf:type rdfs:Datatype ;
                     owl:unionOf ( xsd:NMTOKEN
                                   [ rdf:type rdfs:Datatype ;
                                     owl:oneOf [ rdf:type rdf:List ;
                                                 rdf:first "ce" ;
                                                 rdf:rest rdf:nil
                                               ]
                                   ]
                                 )
                   ] ;
        rdfs:comment "The era attribute is for the corresponding era in a calendar. Most of the time, the values calendar=\"gregorian\" and era=\"ce\" (Common Era of the Gregorian calendar) are used."@en ;
        rdfs:label "has era"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasExplicitText
:hasExplicitText rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Explicit ;
                 rdfs:range xsd:string ;
                 rdfs:comment "it is the text of the explicit"@en ;
                 rdfs:label "has explicit text"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasExtentInfo
:hasExtentInfo rdf:type owl:DatatypeProperty ;
               rdfs:domain :Extent ;
               rdfs:range xsd:string ;
               rdfs:comment "it is the textual value of extent" ;
               rdfs:label "has extent information"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasFileName
:hasFileName rdf:type owl:DatatypeProperty ;
             rdfs:domain :CatalogueIdentifier ;
             rdfs:range xsd:string ;
             rdfs:comment "File name describing the catalogue"@en ;
             rdfs:label "has file name"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasFindAidStatus
:hasFindAidStatus rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Catalogue ;
                  rdfs:range xsd:NMTOKEN ;
                  rdfs:comment "It indicates the status of the finding aid or catalog, for example: incomplete or provisional."@en ;
                  rdfs:label "has find aid status"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasFirstName
:hasFirstName rdf:type owl:DatatypeProperty ;
              rdfs:domain :Person ;
              rdfs:range xsd:string ;
              rdfs:comment "it is the first name of the person"@en ;
              rdfs:label "has first name"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasFoldingFormat
:hasFoldingFormat rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Support ;
                  rdfs:range xsd:string ;
                  rdfs:comment "The result of folding a printed sheet to form a gathering of leaves (e.g., a sheet folded once to form a folio, twice to form a quarto, three times to form an octavo)."@en ;
                  rdfs:label "has folding format"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasFoliation
:hasFoliation rdf:type owl:DatatypeProperty ;
              rdfs:domain :CodicologicalInfo ;
              rdfs:range xsd:string ;
              rdfs:comment "it describes the numbering system or systems (numerotation) used to count the leaves or pages in a codex or similar object"@en ;
              rdfs:label "has foliation"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasFragmentInfo
:hasFragmentInfo rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Fragment ;
                 rdfs:range xsd:string ;
                 rdfs:comment "it gives information about the Separate documents"@en ;
                 rdfs:label "has fragment information"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasFunction
:hasFunction rdf:type owl:DatatypeProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :Institution
                                         :Producer
                                       )
                         ] ;
             rdfs:range xsd:string ;
             rdfs:comment "it is the role played by a person or institution e.g: producer,author,.."@en ;
             rdfs:label "has function"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasGeneration
:hasGeneration rdf:type owl:DatatypeProperty ;
               rdfs:domain :Support ;
               rdfs:range xsd:string ;
               rdfs:comment "for the The relationship between an original carrier and the carrier of a reproduction made from the original (e.g., a first generation camera master, a second generation printing master). It indicates whether the medium is original or a reproduction, for example original: the medium is the original written or created by the copyist; print master or other: the record describes a copy or reproduction (for example a facsimile, microfilm, or print)."@en ;
               rdfs:label "has generation"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasGenre
:hasGenre rdf:type owl:DatatypeProperty ;
          rdfs:domain :Subject ;
          rdfs:range xsd:string ;
          rdfs:comment "it explains what form the documents on this subject take"@en ;
          rdfs:label "has genre"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasGeographic
:hasGeographic rdf:type owl:DatatypeProperty ;
               rdfs:domain :Subject ;
               rdfs:range xsd:string ;
               rdfs:comment "Indicates the geographical location to which the subject is attached. It answers the question: \"Where?\""@en ;
               rdfs:label "has geographic"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasGraphic
:hasGraphic rdf:type owl:DatatypeProperty ;
            rdfs:domain :Image ;
            rdfs:range xsd:anyURI ;
            rdfs:comment "(graphic) indicates the location of an embedded image, illustration, or diagram."@en ;
            rdfs:label "has graphic"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasHeight
:hasHeight rdf:type owl:DatatypeProperty ;
           rdfs:domain :Dimensions ;
           rdfs:range xsd:string ;
           rdfs:comment "the height dimension"@en ;
           rdfs:label "has height"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasID
:hasID rdf:type owl:DatatypeProperty ;
       rdfs:domain [ rdf:type owl:Class ;
                     owl:unionOf ( :IdentificationInformation
                                   :Taxonomy
                                 )
                   ] ;
       rdfs:range xsd:string ;
       rdfs:comment "it is for the id value"@en ;
       rdfs:label "has identifier"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasIdentifier
:hasIdentifier rdf:type owl:DatatypeProperty ;
               rdfs:domain :CatalogueIdentifier ;
               rdfs:range xsd:string ;
               rdfs:comment "gives a unique identifier to the file describing the catalogue"@en ;
               rdfs:label "has identifier"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasIncipitText
:hasIncipitText rdf:type owl:DatatypeProperty ;
                rdfs:domain :Incipit ;
                rdfs:range xsd:string ;
                rdfs:comment "it is the text of the incipit"@en ;
                rdfs:label "has incipit text"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasInk
:hasInk rdf:type owl:DatatypeProperty ;
        rdfs:domain :WrittingStyle ;
        rdfs:range xsd:string ;
        rdfs:comment "describes the shade or type of ink, for example brown, or other writing tool, for example a pencil."@en ;
        rdfs:label "has Ink"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasJurisdiction
:hasJurisdiction rdf:type owl:DatatypeProperty ;
                 rdfs:domain :AccessRestriction ;
                 rdfs:range xsd:string ;
                 rdfs:comment "The name of the person, institution, or institutional role responsible for imposing and/or enforcing access conditions, and to whom requests or appeals regarding these restrictions may be addressed."@en ;
                 rdfs:label "has jurisdiction"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasKey
:hasKey rdf:type owl:DatatypeProperty ;
        rdfs:domain :Place ;
        rdfs:range xsd:string ;
        rdfs:comment "the key code of the country, for example: for Danemark, its key code: DK"@en ;
        rdfs:label "has key"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasKuniya
:hasKuniya rdf:type owl:DatatypeProperty ;
           rdfs:domain :Person ;
           rdfs:range xsd:string ;
           rdfs:comment "contains an additional name component, such as a nickname, epithet, or alias, or any other descriptive phrase used within a personal name."@en ;
           rdfs:label "has kuniya"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLangCode
:hasLangCode rdf:type owl:DatatypeProperty ;
             rdfs:domain :Language ;
             rdfs:range xsd:language ;
             rdfs:comment "​​provides a language code"@en ;
             rdfs:label "has lang code"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLangEncoding
:hasLangEncoding rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Catalogue ;
                 rdfs:range xsd:NMTOKEN ;
                 rdfs:comment "Code for the main language of the file (e.g., lat = Latin, eng = English)"@en ;
                 rdfs:label "has lang encoding"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLangUsageValue
:hasLangUsageValue rdf:type owl:DatatypeProperty ;
                   rdfs:domain :LangUsage ;
                   rdfs:range xsd:string ;
                   rdfs:comment "the lang usage value"@en ;
                   rdfs:label "has lang usage value"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLanguageName
:hasLanguageName rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Language ;
                 rdfs:range xsd:language ;
                 rdfs:comment "it is the name of the language"@en ;
                 rdfs:label "has language name"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLastName
:hasLastName rdf:type owl:DatatypeProperty ;
             rdfs:domain :Person ;
             rdfs:range xsd:string ;
             rdfs:comment "it is the last name of a person"@en ;
             rdfs:label "has last name"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLayoutInfo
:hasLayoutInfo rdf:type owl:DatatypeProperty ;
               rdfs:domain :Layout ;
               rdfs:range xsd:string ;
               rdfs:comment "it is for the arrangement of text, it is the value of the layout element"@en ;
               rdfs:label "has layout information"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLayoutTool
:hasLayoutTool rdf:type owl:DatatypeProperty ;
               rdfs:domain :Layout ;
               rdfs:range xsd:string ;
               rdfs:comment "it specifies the tool used for the layout"@en ;
               rdfs:label "has layout tool"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLegalAuthority
:hasLegalAuthority rdf:type owl:DatatypeProperty ;
                   rdfs:domain :AccessRestriction ;
                   rdfs:range xsd:string ;
                   rdfs:comment "The law or legal authority that imposes the restriction. It specifies the rule on which access is limited, for example, Article 35 of the French Archives Law. This means that access is limited by French law."@en ;
                   rdfs:label "has legal authority"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLegalStatusInfo
:hasLegalStatusInfo rdf:type owl:DatatypeProperty ;
                    rdfs:domain :LegalStatus ;
                    rdfs:range xsd:string ;
                    rdfs:comment "It indicates, using standardized textual values, whether the described document is considered patrimonial or non-patrimonial)."@en ;
                    rdfs:label "has legal status information"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLength
:hasLength rdf:type owl:DatatypeProperty ;
           rdfs:domain :Dimensions ;
           rdfs:range xsd:string ;
           rdfs:comment "the length dimension"@en ;
           rdfs:label "has length"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLineHeight
:hasLineHeight rdf:type owl:DatatypeProperty ;
               rdfs:domain :Layout ;
               rdfs:range xsd:string ;
               rdfs:comment "it specifies the height of lines"@en ;
               rdfs:label "has line height"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLink
:hasLink rdf:type owl:DatatypeProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :ArchRef
                                     :BibRef
                                     :DigitizedVersion
                                   )
                     ] ;
         rdfs:range xsd:anyURI ;
         rdfs:comment "it is the link to the digitized manuscript, or to a bibliographic reference"@en ;
         rdfs:label "has link"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLinkTitle
:hasLinkTitle rdf:type owl:DatatypeProperty ;
              rdfs:domain :DigitizedVersion ;
              rdfs:range xsd:string ;
              rdfs:comment "the title of the link as text"@en ;
              rdfs:label "has link title"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasLocus
:hasLocus rdf:type owl:DatatypeProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :Explicit
                                      :Incipit
                                      :Layout
                                      :MsItem
                                    )
                      ] ;
          rdfs:range xsd:string ;
          rdfs:comment "defines a location within a manuscript, manuscript part, typically as a (possibly discontinuous) sequence of folio references"@en ;
          rdfs:label "has locus"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasMainAgencyCode
:hasMainAgencyCode rdf:type owl:DatatypeProperty ;
                   rdfs:domain :CatalogueIdentifier ;
                   rdfs:range xsd:NMTOKEN ;
                   rdfs:comment "It indicates the institution responsible for publishing the catalogue."@en ;
                   rdfs:label "has main agency code"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasMarginalAdditions
:hasMarginalAdditions rdf:type owl:DatatypeProperty ;
                      rdfs:domain :Manuscript ;
                      rdfs:range xsd:string ;
                      rdfs:comment "contains a description of significant additions found in a manuscript, such as marginal glosses or other annotations. it refers to textual or figurative elements present in the margins of the described manuscript and related to its content. These elements may be contemporary with or later than the document's production."@en ;
                      rdfs:label "has marginal additions"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasMaterial
:hasMaterial rdf:type owl:DatatypeProperty ;
             rdfs:domain :Support ;
             rdfs:range xsd:string ;
             rdfs:comment "It describes the material or materials used to produce a manuscript. that is to say, the material that was primarily used to make the support. It is a particular material for a component or element of the support (ribbon, binding, ornament…). Or used for a short project-defined name for the material composing the majority of the support."@en ;
             rdfs:label "has material"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasMedia
:hasMedia rdf:type owl:DatatypeProperty ;
          rdfs:domain :Support ;
          rdfs:range xsd:string ;
          rdfs:comment "Describes the medium, that is, the material or substance applied to the support: ink, paint, gold leaf,  to create the text or decoration."@en ;
          rdfs:label "has media"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasMediaType
:hasMediaType rdf:type owl:DatatypeProperty ;
              rdfs:domain :Manuscript ;
              rdfs:range xsd:string ;
              rdfs:comment "Media type reflects the general type of intermediation device required to view, play, run, etc., the content of a manuscript"@en ;
              rdfs:label "has media type"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasMsItemID
:hasMsItemID rdf:type owl:DatatypeProperty ;
             rdfs:domain :MsItem ;
             rdfs:range xsd:string ;
             rdfs:comment "it is the ID of the manuscript item"@en ;
             rdfs:label "has msItem ID"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasName
:hasName rdf:type owl:DatatypeProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :Contributor
                                     :Distributor
                                     :Institution
                                     :Person
                                     :Producer
                                     :Publisher
                                     :Subject
                                   )
                     ] ;
         rdfs:range xsd:string ;
         rdfs:comment "it is the full name of an entity e.g: institution, person,.."@en ;
         rdfs:label "has Name"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasNameTranscription
:hasNameTranscription rdf:type owl:DatatypeProperty ;
                      rdfs:domain :Person ;
                      rdfs:range xsd:string ;
                      rdfs:comment "the Transcription of the name"@en ;
                      rdfs:label "has name transcription"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasNormalizedDate
:hasNormalizedDate rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Date ;
                   rdfs:range xsd:date ;
                   rdfs:comment "NormalizedDate is used for indexing and search purposes. Regardless of the values entered in CALENDAR and ERA, this date is always expressed according to the extended ISO 8601 standard (i.e., in the Gregorian calendar), using dashes or not depending on the tool used: YYYYMMDD/YYYYMMDD or YYYY-MM-DD/YYYY-MM-DD."@en ;
                   rdfs:label "has normalized date"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasNormalizedName
:hasNormalizedName rdf:type owl:DatatypeProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( :Institution
                                               :Person
                                               :Place
                                             )
                               ] ;
                   rdfs:range xsd:string ;
                   rdfs:comment "it is for the normalized version of the name"@en ;
                   rdfs:label "has normalized name"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasNormalizedTopic
:hasNormalizedTopic rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Subject ;
                    rdfs:range xsd:string ;
                    rdfs:comment "to give a standardized form of the topic name"@en ;
                    rdfs:label "has normalized topic"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasNote
:hasNote rdf:type owl:DatatypeProperty ;
         rdfs:domain :IdentificationInformation ;
         rdfs:range xsd:string ;
         rdfs:comment "a note that explains the alternatif identifier"@en ;
         rdfs:label "has note"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasNumber
:hasNumber rdf:type owl:DatatypeProperty ;
           rdfs:domain :MsItem ;
           rdfs:range xsd:int ;
           rdfs:comment "it is used to number or label an msItem according to its order within the manuscript"@en ;
           rdfs:label "has number"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasOrigin
:hasOrigin rdf:type owl:DatatypeProperty ;
           rdfs:domain :Record ;
           rdfs:range xsd:string ;
           rdfs:comment "Shows the origin or provenance of the record."@en ;
           rdfs:label "has origin"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasOriginalDimensions
:hasOriginalDimensions rdf:type owl:DatatypeProperty ;
                       rdfs:domain :Support ;
                       rdfs:range xsd:string ;
                       rdfs:comment "This is the dimension of the original parchment/scroll before folding and binding"@en ,
                                    "an extent or codicological information has dimensions"@en ;
                       rdfs:label "has original dimensions"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasOriginalLanguage
:hasOriginalLanguage rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Language ;
                     rdfs:range xsd:string ;
                     rdfs:comment "if it is a translation, we put the language code of the original language of the document."@en ;
                     rdfs:label "has original language"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasOriginalLocation
:hasOriginalLocation rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Manuscript ;
                     rdfs:range xsd:string ;
                     rdfs:comment "provides information on the original document when the notice describes a reproduction, allowing you to know where the original is located and how to identify it. It is used when the document you are describing is not the original, but a reproduction"@en ;
                     rdfs:label "has original location"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasPhysicalAccessProvisions
:hasPhysicalAccessProvisions rdf:type owl:DatatypeProperty ;
                             rdfs:domain :AccessRestriction ;
                             rdfs:range xsd:string ;
                             rdfs:comment "Arrangements required for physical access. Such arrangements may change from time to time." ;
                             rdfs:label "has physical access provisions"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasPhysicalLocation
:hasPhysicalLocation rdf:type owl:DatatypeProperty ;
                     rdfs:domain [ rdf:type owl:Class ;
                                   owl:unionOf ( :Collection
                                                 :Manuscript
                                               )
                                 ] ;
                     rdfs:range [ rdf:type rdfs:Datatype ;
                                  owl:unionOf ( xsd:anyURI
                                                xsd:string
                                              )
                                ] ;
                     rdfs:comment """Information allowing the identification of the place where the described manuscripts are stored.

This may include, for example, the indication that a collection is deposited in another institution, the name or number of a building or storage area, or any other physical location detail, particularly when this location affects access."""@en ;
                     rdfs:label "has pysical location"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasPostCode
:hasPostCode rdf:type owl:DatatypeProperty ;
             rdfs:domain :Address ;
             rdfs:range xsd:string ;
             rdfs:comment "contains a numeric or alphanumeric code that forms part of the postal address and is used to simplify the sorting or distribution of mail."@en ;
             rdfs:label "has post code"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasPreferredCitation
:hasPreferredCitation rdf:type owl:DatatypeProperty ;
                      rdfs:domain :Collection ;
                      rdfs:range xsd:string ;
                      rdfs:comment "To provide information on the form to be used when citing the described collection. This element is particularly useful in the description of the collection but may also be used within the Component element (a manuscript)."@en ;
                      rdfs:label "has preferred citation"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasProcessInfo
:hasProcessInfo rdf:type owl:DatatypeProperty ;
                rdfs:domain :Manuscript ;
                rdfs:range xsd:string ;
                rdfs:comment "To make information on the processing of documentary units and the control of their descriptions accessible to the public. This information may relate to: updates to the format of digital documents to ensure their accessibility;preservation treatments carried out (disinfection, cleaning, dusting);the management of accessions and the cataloging of documents;the control of descriptions (information on the creation and revision of the record description)."@en ;
                rdfs:label "has process information"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasProductionTechnique
:hasProductionTechnique rdf:type owl:DatatypeProperty ;
                        rdfs:domain :CodicologicalInfo ;
                        rdfs:range xsd:string ;
                        rdfs:comment "for the technique used for the creation of the manuscript, that is to say, how the object was made."@en ;
                        rdfs:label "has production technique"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasProjectDesc
:hasProjectDesc rdf:type owl:DatatypeProperty ;
                rdfs:domain :EncodingDesc ;
                rdfs:range xsd:string ;
                rdfs:comment "describes in detail the purpose or objective of encoding an electronic file, as well as any other relevant information about how it was constructed or collected."@en ;
                rdfs:label "has project description"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasProvenance
:hasProvenance rdf:type owl:DatatypeProperty ;
               rdfs:domain :Manuscript ;
               rdfs:range xsd:string ;
               rdfs:comment "It describes its previous history, that is to say, all the stages in the manuscript's life after its creation but before its final acquisition by the current institution."@en ;
               rdfs:label "has provenance"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasPubPlace
:hasPubPlace rdf:type owl:DatatypeProperty ;
             rdfs:domain :PublicationInfo ;
             rdfs:range xsd:string ;
             rdfs:comment "A place associated with the publication event."@en ;
             rdfs:label "has publication place"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasPublisher
:hasPublisher rdf:type owl:DatatypeProperty ;
              rdfs:domain :Catalogue ;
              rdfs:range xsd:string ;
              rdfs:comment "The name of the entity that published  the resource."@en ;
              rdfs:label "has publisher"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasQuireInfo
:hasQuireInfo rdf:type owl:DatatypeProperty ;
              rdfs:domain :Quire ;
              rdfs:range xsd:string ;
              rdfs:comment "the information of the quire or the quires of the manuscript"@en ;
              rdfs:label "has Quire Info"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRatio
:hasRatio rdf:type owl:DatatypeProperty ;
          rdfs:domain :WrittingStyle ;
          rdfs:range xsd:string ;
          rdfs:comment "This corresponds to the ratio between the height and width of the letters to analyze the proportion and elegance of the calligraphic style, for example: 1:1 means square letters (width = height); 2:1 (tall and vertical); 1:2 (very elongated horizontally)"@en ;
          rdfs:label "has ratio"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRecordID
:hasRecordID rdf:type owl:DatatypeProperty ;
             rdfs:domain :Record ;
             rdfs:range xsd:string ;
             rdfs:comment "Contains the system control number assigned by the organization creating, using, or distributing the record."@en ;
             rdfs:label "has record id"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRecordInfo
:hasRecordInfo rdf:type owl:DatatypeProperty ;
               rdfs:domain :Record ;
               rdfs:range xsd:string ;
               rdfs:comment "contains details about the record"@en ;
               rdfs:label "has record information"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRecordTitle
:hasRecordTitle rdf:type owl:DatatypeProperty ;
                rdfs:domain :Record ;
                rdfs:range xsd:string ;
                rdfs:comment "the title of the record"@en ;
                rdfs:label "has record title"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRecordingTechnique
:hasRecordingTechnique rdf:type owl:DatatypeProperty ;
                       rdfs:domain :Support ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Means or technique by which information was recorded in or on the material base (e.g., handwritten, engraved, punched, pressed, cut, molded, thermofax, x-ray)"@en ;
                       rdfs:label "has recording technique"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasReformattingQuality
:hasReformattingQuality rdf:type owl:DatatypeProperty ;
                        rdfs:domain :DigitizedVersion ;
                        rdfs:range xsd:string ;
                        rdfs:comment "It indicates the purpose or intended use of a digital resource, that is, why it was digitized and at what quality. The \"access\" value designates a resource intended for online consultation or quick reference, but not suitable for long-term preservation. The \"preservation\" value corresponds to a resource created to preserve the original over the long term, with high quality. Finally, the \"replacement\" value designates a digital resource of sufficient quality to replace the original if it is lost, damaged, or destroyed."@en ;
                        rdfs:label "has reformatting quality"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRelatedEncoding
:hasRelatedEncoding rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Catalogue ;
                    rdfs:range xsd:string ;
                    rdfs:comment "The RELATEDENCODING attribute should only be set if you want to provide the equivalent of an EAD element in another format using the ENCODINGANALOG attribute. For example, if you decide to create an equivalence to the Dublin Core format for an OAI data export, the value to use is \"dc\"."@en ;
                    rdfs:label "has related encodinging"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRelatedMaterialInfo
:hasRelatedMaterialInfo rdf:type owl:DatatypeProperty ;
                        rdfs:domain :RelatedMaterial ;
                        rdfs:range xsd:string ;
                        rdfs:comment "it gives information about the related documents"@en ;
                        rdfs:label "has related material information"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRelationship
:hasRelationship rdf:type owl:DatatypeProperty ;
                 rdfs:domain :DigitizedVersion ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Relationship between a networked electronic resource at the location identified and the resource described in the record as a whole. It means that if  the record describes a networked electronic or non-electronic  resource."@en ;
                 rdfs:label "has relationship"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRepositoryEncoding
:hasRepositoryEncoding rdf:type owl:DatatypeProperty ;
                       rdfs:domain :Catalogue ;
                       rdfs:range xsd:NMTOKEN ;
                       rdfs:comment "Standardized identifier for the repository or institution (e.g., BNF = Bibliothèque nationale de France)"@en ;
                       rdfs:label "has repository encoding"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRestrictionInfo
:hasRestrictionInfo rdf:type owl:DatatypeProperty ;
                    rdfs:domain :AccessRestriction ;
                    rdfs:range xsd:string ;
                    rdfs:comment "a manuscript has restriction information"@en ;
                    rdfs:label "has restriction information"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRestrictionOrNo
:hasRestrictionOrNo rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Manuscript ;
                    rdfs:range xsd:string ;
                    rdfs:comment "It indicates whether an access restriction is applied to the manuscript. The value #: No information provided, 0: no restriction; 1: Restrictions apply. Details about the restrictions are given in the AccessRestrict class."@en ;
                    rdfs:label "has restriction Or No"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRole
:hasRole rdf:type owl:DatatypeProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :Contributor
                                     :Institution
                                     :Person
                                     :Place
                                   )
                     ] ;
         rdfs:range xsd:string ;
         rdfs:comment "The role played by the entity in the resource e.g. illustrator, traductor,production palce, copy place,.."@en ;
         rdfs:label "has role"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasRuledLines
:hasRuledLines rdf:type owl:DatatypeProperty ;
               rdfs:domain :Layout ;
               rdfs:range xsd:int ;
               rdfs:comment "(ruling lines) specifies the number of ruling lines present per column."@en ;
               rdfs:label "has ruled lines"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasScope
:hasScope rdf:type owl:DatatypeProperty ;
          rdfs:domain :WrittingStyle ;
          rdfs:range xsd:string ;
          rdfs:comment "provides attributes to describe, in general terms, the scope of an element’s application. there are 3 suggested values: sole: only this particular feature is used throughout the document; major:this feature is used through most of the document; minor: this feature is used occasionally through the document"@en ;
          rdfs:label "has scope"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasScopeContent
:hasScopeContent rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Manuscript ;
                 rdfs:range xsd:string ;
                 rdfs:comment "For additional information beyond that contained in the Description and Identification element, relating to the content, scope, subject, form, nature, and genetic state of the manuscript, such as incipit and explicit text, which are given as quotations in blockquote"@en ;
                 rdfs:label "has scope content"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasScribeNumber
:hasScribeNumber rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Manuscript ;
                 rdfs:range xsd:int ;
                 rdfs:comment "specifies the number of different hands (scribes) that could be identified in the manuscript."@en ;
                 rdfs:label "has scribe number"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasScript
:hasScript rdf:type owl:DatatypeProperty ;
           rdfs:domain :WrittingStyle ;
           rdfs:range xsd:string ;
           rdfs:comment "characterizes the calligraphy or particular writing style used by that hand, for example English, chancery, Italian script, etc."@en ;
           rdfs:label "has script"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasScriptEncoding
:hasScriptEncoding rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Catalogue ;
                   rdfs:range xsd:NMTOKEN ;
                   rdfs:comment "Encoding for the writing system used (e.g., Latn = Latin script, Arab = Arabic script"@en ;
                   rdfs:label "has script encoding"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasSeal
:hasSeal rdf:type owl:DatatypeProperty ;
         rdfs:domain :CodicologicalInfo ;
         rdfs:range xsd:string ;
         rdfs:comment "contains the description of a seal or similar object attached to the manuscript."@en ;
         rdfs:label "has seal"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasSettlement
:hasSettlement rdf:type owl:DatatypeProperty ;
               rdfs:domain :Address ;
               rdfs:range xsd:string ;
               rdfs:comment "(settlement place) contains the name of a settlement place such as a city, town or village, identified as a unique geopolitical or administrative unit."@en ;
               rdfs:label "has settlement"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasShelvingLocation
:hasShelvingLocation rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Institution ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Shelving location of the item within the collection of the holding organization. It may be used to indicate the physical location within a sublocation; for example, reference alcove, oversize shelving"@en ;
                     rdfs:label "has shelving location"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasShelvingOrder
:hasShelvingOrder rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Institution ;
                  rdfs:range xsd:string ;
                  rdfs:comment "It indicates the numbering system used to shelve the copy; that is, the numbering system the library uses to physically classify this document."@en ;
                  rdfs:label "has shelving order"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasSourceCodeLang
:hasSourceCodeLang rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Language ;
                   rdfs:range xsd:string ;
                   rdfs:comment "It indicates the origin of the language codes used in the field."@en ;
                   rdfs:label "has source code lang"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasSponsor
:hasSponsor rdf:type owl:DatatypeProperty ;
            rdfs:domain :Catalogue ;
            rdfs:range xsd:string ;
            rdfs:comment "for the names of the people or institutions that supported, financed or organised all or part of the process of creating and disseminating the finding aid (catalogue)"@en ;
            rdfs:label "has sponsor"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasState
:hasState rdf:type owl:DatatypeProperty ;
          rdfs:domain :CodicologicalInfo ;
          rdfs:range xsd:string ;
          rdfs:comment "contains the description of the physical condition of the manuscript and its alterations."@en ;
          rdfs:label "has state"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasStatementOfResponsibility
:hasStatementOfResponsibility rdf:type owl:DatatypeProperty ;
                              rdfs:domain :Manuscript ;
                              rdfs:range xsd:string ;
                              rdfs:comment "It is the text appearing on the document that indicates the people or organizations that participated in the creation of the work. It is reproduced exactly as it appears in the source of information, without modification or standardization."@en ;
                              rdfs:label "has statement Of responsibility"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasStreet
:hasStreet rdf:type owl:DatatypeProperty ;
           rdfs:domain :Address ;
           rdfs:range xsd:string ;
           rdfs:comment "A complete street address including a name or number identifying a building and the name of the street or road on which it is located."@en ;
           rdfs:label "has street"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasSubTitle
:hasSubTitle rdf:type owl:DatatypeProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :Catalogue
                                         :Collection
                                         :Manuscript
                                       )
                         ] ;
             rdfs:range xsd:string ;
             rdfs:comment "for the subtitle or complement to the title"@en ;
             rdfs:label "has sub title"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasSubordinateUnit
:hasSubordinateUnit rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Institution ;
                    rdfs:range xsd:string ;
                    rdfs:comment "It is an internal part (internal division) of a main institution, for example the Department of Manuscripts is a subordinate unit that depends on the BNF."@en ;
                    rdfs:label "has subordinate unit"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasSurface
:hasSurface rdf:type owl:DatatypeProperty ;
            rdfs:domain :Image ;
            rdfs:range xsd:string ;
            rdfs:comment "define a surface written as a rectangle described by its spatial coordinates, possibly grouping one or more graphical representations of this space and interesting rectangular areas within it."@en ;
            rdfs:label "has surface"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasTemporal
:hasTemporal rdf:type owl:DatatypeProperty ;
             rdfs:domain :Subject ;
             rdfs:range xsd:string ;
             rdfs:comment "Indicates the historical period to which the subject applies. It answers the question: \"when?\""@en ;
             rdfs:label "has temporal"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasTermsOfAddress
:hasTermsOfAddress rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Person ;
                   rdfs:range xsd:string ;
                   rdfs:comment "for titles and enumeration associated with a name, such as Jr., II, etc."@en ;
                   rdfs:label "has terms of address"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasTitle
:hasTitle rdf:type owl:DatatypeProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :Catalogue
                                      :Collection
                                      :Manuscript
                                      :Volume
                                    )
                      ] ;
          rdfs:range xsd:string ;
          rdfs:comment "the  title of a work like: catalogue, collection, manuscript, Volume,...."@en ;
          rdfs:label "has title"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasTopic
:hasTopic rdf:type owl:DatatypeProperty ;
          rdfs:domain :Subject ;
          rdfs:range xsd:short ;
          rdfs:comment "Describes the particular aspect, angle, or theme from which the subject is treated. It answers the question: \"What exactly?\""@en ;
          rdfs:label "has topic"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasTranscribingAgency
:hasTranscribingAgency rdf:type owl:DatatypeProperty ;
                       rdfs:domain :Record ;
                       rdfs:range xsd:string ;
                       rdfs:comment "code or the name of the organization that transcribed the record into machine-readable form."@en ;
                       rdfs:label "has transcribing agency"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasType
:hasType rdf:type owl:DatatypeProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :AccessRestriction
                                     :City
                                     :Date
                                     :Decoration
                                     :DigitizedVersion
                                     :Dimensions
                                     :Explicit
                                     :Extent
                                     :IdentificationInformation
                                     :Incipit
                                     :LegalStatus
                                     :MsItem
                                     :Support
                                   )
                     ] ;
         rdfs:range xsd:string ;
         rdfs:comment """The electronic format type, or the data representation, of the resource. 
that is to say, to indicate the exact electronic format of the digital resource, for example image/jpeg, application/pdf, text/xml, audio/mpeg, video/mp4"""@en ,
                      "for the type of the date, for example: approximative date"@en ,
                      "il also used for the type of the extent, for example unit number, duration,.."@en ,
                      "it is also used for the physical medium in which the manuscript is presented, for example in the form of a scroll or codex"@en ,
                      "il also indicates the nature of the document owner." ,
                      "it also Identifies what type of access condition is recorded foe eg restriction on access, use and reproduction" ;
         rdfs:label "has type"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasURL
:hasURL rdf:type owl:DatatypeProperty ;
        rdfs:domain :Institution ;
        rdfs:range xsd:anyURI ;
        rdfs:comment "The URI links to the repository that holds the item (regardless of whether the item is analog or digital)"@en ;
        rdfs:label "has url"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasUniformTitle
:hasUniformTitle rdf:type owl:DatatypeProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( :Collection
                                             :UniformTitleSubject
                                           )
                             ] ;
                 rdfs:range xsd:string ;
                 rdfs:comment "it is to add a uniform title of the title"@en ;
                 rdfs:label "has a uniform title"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasUnit
:hasUnit rdf:type owl:DatatypeProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :Dimensions
                                     :Extent
                                   )
                     ] ;
         rdfs:range xsd:string ;
         rdfs:comment "Indicates the unit of measurement (e.g. inches, cm, grams, liters, minutes) for the value(s) in the extent element. It is used to provide more information regarding extent by separating out unit type."@en ;
         rdfs:label "has unit"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasUseRestriction
:hasUseRestriction rdf:type owl:DatatypeProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( :Collection
                                               :Manuscript
                                             )
                               ] ;
                   rdfs:range xsd:string ;
                   rdfs:comment "This is for information indicating whether the reproduction or use of a documentary unit is subject to conditions"@en ;
                   rdfs:label "has use restriction"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasVolume
:hasVolume rdf:type owl:DatatypeProperty ;
           rdfs:domain :Collection ;
           rdfs:range xsd:string ;
           rdfs:comment "the volumes of a collection"@en ;
           rdfs:label "has volume"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasVolumeNumber
:hasVolumeNumber rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Volume ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Specifies the ordinal number or designation of a volume within a manuscript, such as Volume 1, Volume 2, or Tome 3."@en ;
                 rdfs:label "has volume number"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasVolumeType
:hasVolumeType rdf:type owl:DatatypeProperty ;
               rdfs:domain :Volume ;
               rdfs:range xsd:string ;
               rdfs:comment "Specifies the type or role of a volume within a manuscript, such as main, secondary, supplementary, or other material subdivision.\""@en ;
               rdfs:label "has volume type"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasWaterMark
:hasWaterMark rdf:type owl:DatatypeProperty ;
              rdfs:domain :Support ;
              rdfs:range xsd:string ;
              rdfs:comment "It contains a word or expression describing a watermark or a similar mark."@en ;
              rdfs:label "has water mark"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasWidth
:hasWidth rdf:type owl:DatatypeProperty ;
          rdfs:domain :Dimensions ;
          rdfs:range xsd:string ;
          rdfs:comment "the width dimension"@en ;
          rdfs:label "has width"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#hasWrittenLines
:hasWrittenLines rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Layout ;
                 rdfs:range xsd:int ;
                 rdfs:comment "(writing lines) specifies the number of lines written per column."@en ;
                 rdfs:label "has written lines"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isAbsent
:isAbsent rdf:type owl:DatatypeProperty ;
          rdfs:domain :Manuscript ;
          rdfs:range xsd:string ;
          rdfs:comment "To report the permanent absence of the described manuscript (confirmed disappearance, accidental destruction, permanent transfer or return to its owner)"@en ;
          rdfs:label "is absent"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isDefective
:isDefective rdf:type owl:DatatypeProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :Explicit
                                         :Incipit
                                       )
                         ] ;
             rdfs:range xsd:boolean ;
             rdfs:comment "indicates whether the incipit or explicit text is defective, i.e. incomplete through loss or damage."@en ;
             rdfs:label "is defective"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isNormalized
:isNormalized rdf:type owl:DatatypeProperty ;
              rdfs:domain :Collection ;
              rdfs:range xsd:boolean ;
              rdfs:comment "to designate or not secondary collection access points (uniform titles, personal names, etc.)"@en ;
              rdfs:label "is normalized or non"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isOriginal
:isOriginal rdf:type owl:DatatypeProperty ;
            rdfs:domain :Binding ;
            rdfs:range xsd:boolean ;
            rdfs:comment "describes if the binding is original or no, it is booleen"@en ;
            rdfs:label "is Original"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#isTranslation
:isTranslation rdf:type owl:DatatypeProperty ;
               rdfs:domain :Language ;
               rdfs:range xsd:string ;
               rdfs:comment "It indicates whether the manuscript is a translation or contains a translation"@en ;
               rdfs:label "is translation"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#notAfter
:notAfter rdf:type owl:DatatypeProperty ;
          rdfs:domain :Date ;
          rdfs:range xsd:date ;
          rdfs:comment "The latest possible date, the event (writing, copying, creation, etc.) cannot be later  than this date"@en ;
          rdfs:label "not after"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#notBefore
:notBefore rdf:type owl:DatatypeProperty ;
           rdfs:domain :Date ;
           rdfs:range xsd:date ;
           rdfs:comment "The earliest possible date, the event (writing, copying, creation, etc.) cannot be earlier than this date"@en ;
           rdfs:label "not before"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#principalSubjectOrNo
:principalSubjectOrNo rdf:type owl:DatatypeProperty ;
                      rdfs:domain :Subject ;
                      rdfs:range xsd:string ;
                      rdfs:comment "It indicates the level of subject,is primary or secondary or nothing specified or no information provided"@en ;
                      rdfs:label "principal subject or no"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#startWith
:startWith rdf:type owl:DatatypeProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :Person
                                       :PersonSubject
                                     )
                       ] ;
           rdfs:range xsd:string ;
           rdfs:comment "It indicates how the name is formulated (input element) (starts with first name, last name or family name)"@en ;
           rdfs:label "start with"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#whenChanged
:whenChanged rdf:type owl:DatatypeProperty ;
             rdfs:domain :RevisionDesc ;
             rdfs:range xsd:date ;
             rdfs:comment "it is the date or the date and time of the change"@en ;
             rdfs:label "when changed"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#whoChanged
:whoChanged rdf:type owl:DatatypeProperty ;
            rdfs:domain :RevisionDesc ;
            rdfs:range xsd:string ;
            rdfs:comment "indicates the person or group of people who changed the record"@en ;
            rdfs:label "who changed"@en .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#AccessRestriction
:AccessRestriction rdf:type owl:Class ;
                   rdfs:comment "It  indicates if the described archival unit is subject to access restrictions (consultation conditions imposed by rights holders or by the holding institution in accordance with contractual, regulatory, or legal obligations)."@en ;
                   rdfs:label "access restriction"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Address
:Address rdf:type owl:Class ;
         rdfs:comment "it is used for information concerning the address,for example the address of the holding institution."@en ;
         rdfs:label "Address"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#ArchRef
:ArchRef rdf:type owl:Class ;
         rdfs:comment "Reference to other archival documents"@en ;
         rdfs:label "archival reference"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Author
:Author rdf:type owl:Class ;
        rdfs:subClassOf :Person ;
        rdfs:comment "it is the author of the content of the manuscript or the catalogue"@en ;
        rdfs:label "author"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#BibRef
:BibRef rdf:type owl:Class ;
        rdfs:comment "it is a bibliography reference contained in a bibliography"@en ;
        rdfs:label "bibliographic reference"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Bibliography
:Bibliography rdf:type owl:Class ;
              rdfs:comment "provides the bibliographic or descriptive reference"@en ;
              rdfs:label "bibliography"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Binding
:Binding rdf:type owl:Class ;
         rdfs:comment "it describes the current and former bindings of a manuscript"@en ;
         rdfs:label "binding"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Catalogue
:Catalogue rdf:type owl:Class ;
           rdfs:comment "It is a finding aid that describes a collection of manuscripts and facilitates access to it for consultation or use by researchers and users.It contains bibliographic records"@en ;
           rdfs:label "Catalogue"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#CatalogueIdentifier
:CatalogueIdentifier rdf:type owl:Class ;
                     rdfs:comment "It contains essential information for unique identification and computerized catalogue management"@en ;
                     rdfs:label "Catalogue Identifier"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#City
:City rdf:type owl:Class ;
      rdfs:subClassOf :Place ;
      rdfs:comment "the city where the manuscript is conserved"@en ;
      rdfs:label "city"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#CodicologicalInfo
:CodicologicalInfo rdf:type owl:Class ;
                   rdfs:comment "it describes the composition of a codex, in particular the number and organization of the quires, specifying where applicable the presence of signatures, catchwords, old foliations, binding, etc."@en ;
                   rdfs:label "Codicological Information"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Collection
:Collection rdf:type owl:Class ;
            rdfs:comment "It is a container that contains manuscripts"@en ;
            rdfs:label "Collection"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Contributor
:Contributor rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Class ;
                               owl:unionOf ( :Institution
                                             :Person
                                           )
                             ] ;
             rdfs:comment "A contributor is any person,family or institution, that participates in the creation or production of a resource without being its primary author, for example a co-author who writes part of the text, a translator who makes the work accessible in another language, a scholarly editor who adds notes or an introduction, an illustrator who creates images for the work, a writer who contributes specific sections, or a scribe who copies a manuscript."@en ;
             rdfs:label "contributor"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#CorporateSubject
:CorporateSubject rdf:type owl:Class ;
                  rdfs:subClassOf [ owl:intersectionOf ( :Institution
                                                         :Subject
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
                  rdfs:comment "It is used when the subject of the manuscript is a collectivity or institution"@en ;
                  rdfs:label "corporate subject"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Country
:Country rdf:type owl:Class ;
         rdfs:subClassOf :Place ;
         rdfs:comment "contains the name of a geo-political unit, such as a nation, country, colony, or common wealth, larger than or administratively superior to a region and smaller than a bloc where the manuscript is conserved"@en ;
         rdfs:label "country"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Date
:Date rdf:type owl:Class ;
      rdfs:comment "it is used for the creation date of an archival unit (the collection or the manuscript)"@en ;
      rdfs:label "Date"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Decoration
:Decoration rdf:type owl:Class ;
            rdfs:comment "contains the description of the manuscript's decoration"@en ;
            rdfs:label "decoration"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#DigitizedVersion
:DigitizedVersion rdf:type owl:Class ;
                  rdfs:comment "for the Digitized Version of the manuscript"@en ;
                  rdfs:label "Digitized Version"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Dimensions
:Dimensions rdf:type owl:Class ;
            rdfs:subClassOf [ rdf:type owl:Class ;
                              owl:unionOf ( :Institution
                                            :Person
                                          )
                            ] ;
            rdfs:comment "it is for the dimensions of the manuscript. Dimensions of the object/item as it is catalogued and used (often after folding, binding, etc.)."@en ;
            rdfs:label "dimensions"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Distributor
:Distributor rdf:type owl:Class ;
             rdfs:comment "it is the distributor of the record"@en ;
             rdfs:label "distributor"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#EncodingDesc
:EncodingDesc rdf:type owl:Class ;
              rdfs:comment "How was the encoding done and according to which choices / conventions / systems, i.e. how was the file encoded (methods, standards, vocabularies)."@en ;
              rdfs:label "encoding description"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Explicit
:Explicit rdf:type owl:Class ;
          rdfs:comment "it is the closing words or final passage of a text, marking the end of the work."@en ;
          rdfs:label "explicit"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Extent
:Extent rdf:type owl:Class ;
        rdfs:comment "Describes the extent of a manuscript or text, in terms of the number of folios, pages, fascicles (gatherings), or volumes (complete books which may contain multiple fascicles) and units of measurement and material. It describes the approximate size of a text stored on its medium, digital or non-digital, expressed in any appropriate unit."@en ;
        rdfs:label "extent"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Fragment
:Fragment rdf:type owl:Class ;
          rdfs:comment """(fragment of a manuscript) contains information about a fragment of a dispersed manuscript, now preserved separately or incorporated into another manuscript. 
It is used if the document was originally part of the manuscript but has been removed, detached, scattered, or kept elsewhere. Example: Page torn out and kept elsewhere"""@en ;
          rdfs:label "Fragment"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#GeographicSubject
:GeographicSubject rdf:type owl:Class ;
                   rdfs:subClassOf [ owl:intersectionOf ( :Place
                                                          :Subject
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
                   rdfs:comment "It is used when the subject of the manuscript is a geographic name"@en ;
                   rdfs:label "Geographic Subject"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#IdentificationInformation
:IdentificationInformation rdf:type owl:Class ;
                           rdfs:comment """It is for the identifier of the archival unit.
it supplies any form of identifier used to identify some object, such as a bibliographic item, a person, a title, an organization, etc. in a standardized way."""@en ;
                           rdfs:label "identification information"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Image
:Image rdf:type owl:Class ;
       rdfs:subClassOf :DigitizedVersion ;
       rdfs:comment "the digitized version of the manuscript may be an image. It contains a representation of any written source in the form of a set of images rather than in the form of a transcribed or encoded text."@en ;
       rdfs:label "image"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Incipit
:Incipit rdf:type owl:Class ;
         rdfs:comment "it is the opening words or initial passage of a text, used to identify or introduce the work"@en ;
         rdfs:label "incipit"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Institution
:Institution rdf:type owl:Class ;
             owl:disjointWith :Person ;
             rdfs:comment "it is for the institution or organization responsible for the described archival units."@en ;
             rdfs:label "Institution"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#LangUsage
:LangUsage rdf:type owl:Class ;
           rdfs:comment "It is used to indicate the language or languages in which the finding aid (catalogue) was written. it can contain text"@en ;
           rdfs:label "Lang Usage"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Language
:Language rdf:type owl:Class ;
          rdfs:comment "It serves to indicate the language or languages ​​in which the manuscript (or its work contents) itself is written (the textual content, the works, the treatises, etc.)."@en ,
                       "language is used to encode a language and, if applicable, the associated writing system."@en ;
          rdfs:label "Language"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Layout
:Layout rdf:type owl:Class ;
        rdfs:comment "it gathers descriptions of the layouts of a manuscript. It describes how the text is laid out on the page, which includes information on any ruling systems, stitching, or other page preparation techniques."@en ;
        rdfs:label "layout"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#LegalStatus
:LegalStatus rdf:type owl:Class ;
             rdfs:comment "The access restriction element must include the LegalStatus element to specify the owner and the heritage status of the document."@en ;
             rdfs:label "legal status"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Manuscript
:Manuscript rdf:type owl:Class ;
            rdfs:comment "it is the ressource to be described in a record"@en ;
            rdfs:label "Manuscript"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#MsItem
:MsItem rdf:type owl:Class ;
        rdfs:comment "describes an individual work (text) or item within the intellectual content of a manuscript or manuscript part.."@en ;
        rdfs:label "manuscript item"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Person
:Person rdf:type owl:Class ;
        rdfs:comment "A Person is an individual human agent who contributes to the creation, production, or realization of a work, such as an author, scribe, editor, or producer."@en ;
        rdfs:label "person"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#PersonSubject
:PersonSubject rdf:type owl:Class ;
               rdfs:subClassOf [ owl:intersectionOf ( :Person
                                                      :Subject
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
               rdfs:comment "It is used when the subject of the document is a person"@en ;
               rdfs:label "person subject"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Place
:Place rdf:type owl:Class ;
       rdfs:comment "contains any form of place name, used to identify the place of origin for a manuscript, manuscript part, or other object. is used to identify a place (city, region, country, etc.)."@en ;
       rdfs:label "place"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Producer
:Producer rdf:type owl:Class ;
          rdfs:subClassOf [ rdf:type owl:Class ;
                            owl:unionOf ( :Institution
                                          :Person
                                        )
                          ] ;
          rdfs:comment "It designates the producer in the archival sense, that is, the person or organization that created or assembled a fonds or a collection."@en ;
          rdfs:label "producer"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#PublicationInfo
:PublicationInfo rdf:type owl:Class ;
                 rdfs:comment "Information about the publictation of the resource, including place of publication, publisher, and dates associated with the resource."@en ;
                 rdfs:label "publiaction informations"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Publisher
:Publisher rdf:type owl:Class ;
           rdfs:comment "it is the publisher of the record"@en ;
           rdfs:label "publisher"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Quire
:Quire rdf:type owl:Class ;
       rdfs:comment "It is for the collation, which is used to describe the physical organization of a manuscript’s leaves by specifying the number of gatherings, their size, their structure (bifolia, lacunae, additions, irregularities), as well as any quire signatures"@en ;
       rdfs:label "Quire"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Record
:Record rdf:type owl:Class ;
        rdfs:comment "It is a standardized cataloguing description that represents a manuscript as a unique physical and intellectual object, documenting its content, physical characteristics, provenance, and location in order to enable identification, management, and access."@en ;
        rdfs:label "Record"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#RelatedMaterial
:RelatedMaterial rdf:type owl:Class ;
                 rdfs:comment "Related documents without physical separation: These are documents that have an intellectual or contextual link, but which have never been part of the same physical set. That is to say, for all documents that are intellectually or historically linked, but never physically united. Example: Another copy of the same text kept in a different library."@en ;
                 rdfs:label "Related Material"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#RevisionDesc
:RevisionDesc rdf:type owl:Class ;
              rdfs:comment "This is for information on changes or modifications made to the finding aid (catalogue, record)."@en ;
              rdfs:label "revision description"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Scribe
:Scribe rdf:type owl:Class ;
        rdfs:subClassOf :Person ;
        rdfs:comment "This is the person who copied a manuscript, that is, who wrote the text onto the material (parchment, paper, etc.). He may also add annotations, corrections, or decorations. He is also called  copyist"@en ;
        rdfs:label "scribe"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Subject
:Subject rdf:type owl:Class ;
         rdfs:comment "A term or phrase representing the primary topic(s) on which a work is focused. It can be controlled or uncontrolled"@en ;
         rdfs:label "subject"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Support
:Support rdf:type owl:Class ;
         rdfs:comment "It describes the physical writing support of the manuscript’s text, for example: parchment, paper, papyrus, etc."@en ;
         rdfs:label "support"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Taxonomy
:Taxonomy rdf:type owl:Class ;
          rdfs:comment "contains one or more taxonomies defining the classification codes used anywhere in the text. A taxonomy is a structured system of categories that allows information to be classified and organized, indicating the system according to which the subjects, themes, or concepts of the document are classified; for example, LCSH taxonomy."@en ;
          rdfs:label "taxonomy"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#TemporalSubject
:TemporalSubject rdf:type owl:Class ;
                 rdfs:subClassOf :Subject ;
                 rdfs:comment "It is used when the subject of the manuscript is a chronological term"@en ;
                 rdfs:label "Temporal Subject"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#UniformTitleSubject
:UniformTitleSubject rdf:type owl:Class ;
                     rdfs:subClassOf :Subject ;
                     rdfs:comment "it is used when the subject of the manuscript is a recognized and standardized work title"@en ;
                     rdfs:label "Uniform Title Subject"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#Volume
:Volume rdf:type owl:Class ;
        rdfs:comment "A physical subdivision of a manuscript representing one material unit within the whole manuscript. A manuscript may consist of one or more volumes, each of which may contain one or more textual or intellectual components."@en ;
        rdfs:label "Volume"@en .


###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#WrittingStyle
:WrittingStyle rdf:type owl:Class ;
               rdfs:comment "describes the writing style used for the manuscript"@en ;
               rdfs:label "Writting Style"@en .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/dualcomputer/ontologies/2025/10/ucomm#dat
:dat rdf:type owl:NamedIndividual .


